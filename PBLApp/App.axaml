<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:local="using:PBLApp"
             x:Class="PBLApp.App">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <suki:SukiTheme ThemeColor="Orange" />
        <StyleInclude Source="avares://PBLApp/Themes/Theme.axaml" />
    </Application.Styles>
</Application>
