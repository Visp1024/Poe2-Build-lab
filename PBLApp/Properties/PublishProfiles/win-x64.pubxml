<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained Windows x64 single-file publish.

  Usage:
    dotnet publish PBLApp/PBLApp.csproj -p:PublishProfile=win-x64 -o publish/win-x64

  Output:
    publish/win-x64/PBLApp.exe        — single-file self-contained app (no .NET install needed)
    publish/win-x64/Assets/TreeData/  — tree sprite sheets (copied as Content)
    publish/win-x64/src/              — Lua engine sources (CopyEngineFiles target)
    publish/win-x64/runtime/lua/      — Lua compat shim & lua-utf8 stubs (CopyEngineFiles target)
    publish/win-x64/lua/compat.lua    — Lua compat shim (copied next to exe)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- ReadyToRun adds ~30 MB; skip for smaller distribution. Re-enable if startup is slow. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Trimming requires DynamicallyAccessedMembers annotations all over NLua / Avalonia bindings;
         leaving it off keeps the build reliable. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
