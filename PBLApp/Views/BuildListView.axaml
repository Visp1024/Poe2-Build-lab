<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PBLApp.ViewModels"
             xmlns:loc="using:PBLApp.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="PBLApp.Views.BuildListView"
             x:DataType="vm:BuildListViewModel"
             Background="{DynamicResource BgBaseBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="{StaticResource PaddingHeader}"
                Background="{DynamicResource BgMantleBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image Grid.Column="0"
                       Source="/Assets/icon.png"
                       Height="48" Width="48"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Stretch="Uniform" />
                <TextBlock Grid.Column="1"
                           Text="{loc:Tr List_Title}"
                           Classes="h1"
                           VerticalAlignment="Center" />

                <!-- Language selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr List_Language}"
                               Classes="caption"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="LangCombo"
                              MinWidth="60">
                        <ComboBoxItem Content="EN" Tag="en" />
                        <ComboBoxItem Content="RU" Tag="ru" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Empty state hint -->
        <TextBlock Grid.Row="1"
                   IsVisible="{Binding IsEmpty}"
                   Text="{loc:Tr List_Empty}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Classes="body-sm" />

        <!-- Build tree -->
        <TreeView Grid.Row="1"
                  x:Name="BuildTree"
                  IsVisible="{Binding !IsEmpty}"
                  ItemsSource="{Binding Builds}"
                  SelectedItem="{Binding SelectedBuild}"
                  Background="Transparent"
                  Margin="8">
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="{x:Type vm:BuildEntryViewModel}"
                                  ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" Classes="body" />
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.Styles>
        </TreeView>

        <!-- Toolbar + status -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="4"
                    Margin="8,4,8,8">
            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource DangerBrush}"
                       Classes="body-sm"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Tr Btn_OpenBuild}"
                        Command="{Binding OpenBuildCommand}" />
                <Button Content="{loc:Tr Btn_NewBuild}"
                        Command="{Binding NewBuildCommand}" />
                <Button Content="{loc:Tr Btn_Delete}"
                        Command="{Binding DeleteBuildCommand}" />
                <Button Content="{loc:Tr Btn_Refresh}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </StackPanel>

    </Grid>

</UserControl>
