<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PBLApp.ViewModels"
             xmlns:loc="using:PBLApp.Localization"
             xmlns:ctl="using:PBLApp.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="PBLApp.Views.BuildListView"
             x:DataType="vm:BuildListViewModel"
             Background="{DynamicResource BgBaseBrush}">

    <UserControl.Resources>
        <ctl:AscendancyIconConverter x:Key="AscIcon" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Cards are Borders (not Buttons) because SukiTheme's Button ContentPresenter
             refused to stretch and ended up left-aligning the inner content. Click is
             handled by Card_PointerPressed in code-behind. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="240" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brand500Brush}" />
        </Style>
        <Style Selector="Border.card.create">
            <Setter Property="BorderBrush" Value="{DynamicResource Brand500Brush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.card.create:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brand100Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brand400Brush}" />
        </Style>

        <!-- × delete corner — Border (not Button) so the hover fill is a clean 24×24
             circle. SukiTheme's Button template grew the inner background into a
             horizontal pill on hover regardless of explicit Width/CornerRadius. -->
        <Style Selector="Border.card-delete">
            <Setter Property="Background" Value="#80000000" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.card-delete:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Border.card-delete TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.card-delete:pointerover TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Breadcrumb segment -->
        <Style Selector="Button.crumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brand400Brush}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.crumb:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Brand500Brush}" />
        </Style>
        <Style Selector="TextBlock.crumb-last">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style Selector="TextBlock.crumb-sep">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="{StaticResource PaddingHeader}"
                Background="{DynamicResource BgMantleBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image Grid.Column="0"
                       Source="/Assets/icon.png"
                       Height="48" Width="48"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Stretch="Uniform" />
                <TextBlock Grid.Column="1"
                           Text="{loc:Tr List_Title}"
                           Classes="h1"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr List_Language}"
                               Classes="caption"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="LangCombo" MinWidth="60">
                        <ComboBoxItem Content="EN" Tag="en" />
                        <ComboBoxItem Content="RU" Tag="ru" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Breadcrumb -->
        <Border Grid.Row="1"
                Padding="16,8"
                Background="{DynamicResource BgMantleBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding Breadcrumb}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BreadcrumbSegment">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button Classes="crumb"
                                    Content="{Binding Name}"
                                    Command="{Binding $parent[UserControl].((vm:BuildListViewModel)DataContext).NavigateBreadcrumbCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding !IsLast}" />
                            <TextBlock Classes="crumb-last"
                                       Text="{Binding Name}"
                                       IsVisible="{Binding IsLast}" />
                            <TextBlock Classes="crumb-sep"
                                       Text="›"
                                       IsVisible="{Binding !IsLast}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Card grid -->
        <ScrollViewer Grid.Row="2" Padding="16">
            <ItemsControl ItemsSource="{Binding CurrentItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="216" ItemHeight="256" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BuildEntryViewModel">
                        <Grid Margin="8">
                            <Border Classes="card"
                                    Classes.create="{Binding IsCreate}"
                                    Tag="{Binding}"
                                    PointerPressed="Card_PointerPressed">
                                <Grid RowDefinitions="*,Auto,Auto" Margin="14,16,14,14"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch">

                                    <!-- Build / folder body -->
                                    <Grid Grid.Row="0" IsVisible="{Binding !IsCreate}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                        <!-- Folder glyph (centered) -->
                                        <TextBlock IsVisible="{Binding IsFolder}"
                                                   Text="📁" FontSize="80"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <!-- Build ascendancy icon (centered, square) -->
                                        <Image IsVisible="{Binding IsBuild}"
                                               Width="148" Height="148"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Stretch="Uniform">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource AscIcon}">
                                                    <Binding Path="ClassName" />
                                                    <Binding Path="AscendClassName" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                    <TextBlock Grid.Row="1" IsVisible="{Binding !IsCreate}"
                                               Text="{Binding Name}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,6,0,2" />
                                    <TextBlock Grid.Row="2" IsVisible="{Binding !IsCreate}"
                                               Text="{Binding Subtitle}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Create card body -->
                                    <StackPanel Grid.Row="0" Grid.RowSpan="3"
                                                IsVisible="{Binding IsCreate}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <TextBlock Text="+"
                                                   FontSize="80" FontWeight="Light"
                                                   Foreground="{DynamicResource Brand500Brush}"
                                                   HorizontalAlignment="Center"
                                                   LineHeight="80" />
                                        <TextBlock Text="{loc:Tr List_CreateCard}"
                                                   Foreground="{DynamicResource Brand500Brush}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Delete corner — hidden on create -->
                            <Border Classes="card-delete"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,6,6,0"
                                    IsVisible="{Binding !IsCreate}"
                                    Tag="{Binding}"
                                    PointerPressed="DeleteCard_PointerPressed"
                                    ToolTip.Tip="{loc:Tr Btn_Delete}">
                                <TextBlock Text="✕" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status footer -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource DangerBrush}"
                   Margin="16,4,16,12"
                   TextWrapping="Wrap" />

    </Grid>

</UserControl>
