<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PBLApp.ViewModels"
             xmlns:eng="using:PBLEngine"
             xmlns:loc="using:PBLApp.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="PBLApp.Views.ItemEditorView"
             x:DataType="vm:ItemEditorViewModel">

    <UserControl.Styles>

        <!-- House-style card frame (matches Calcs/Config; replaces the old gold game frame) -->
        <Style Selector="Border.tooltip-frame">
            <Setter Property="Background" Value="{DynamicResource BgMantleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style Selector="Border.tooltip-inset">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.tooltip-sep">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>

        <!-- Rarity toggle button — house segmented look -->
        <Style Selector="Button.rarity-btn">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
        </Style>
        <Style Selector="Button.rarity-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}"/>
        </Style>
        <Style Selector="Button.rarity-btn.active">
            <Setter Property="BorderBrush" Value="{DynamicResource Brand500Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.rarity-btn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}"/>
        </Style>

        <!-- Flat list item rows -->
        <Style Selector="Button.list-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.list-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.list-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
        </Style>
        <Style Selector="Button.list-btn.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}"/>
        </Style>

        <!-- Unified section header — one size/weight/colour for every section title
             in the editor (Mods, Runes, Category, Base, Selected …) so they stop "dancing". -->
        <Style Selector="TextBlock.sec-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="0.4"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Small text input -->
        <Style Selector="TextBox.ed-input">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>
        <Style Selector="TextBox.ed-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Brand500Brush}"/>
        </Style>

        <!-- ComboBox style -->
        <Style Selector="ComboBox.ed-combo">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Action button -->
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AttrIntBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.action-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgOverlayBrush}"/>
        </Style>

        <!-- Save button -->
        <Style Selector="Button.save-btn">
            <Setter Property="Background" Value="{DynamicResource ConfirmBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AttrDexBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AttrDexBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.save-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ConfirmHoverBrush}"/>
        </Style>

        <!-- Danger button (cancel/remove) -->
        <Style Selector="Button.cancel-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ModImplicitBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.cancel-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
        </Style>

        <!-- Remove mod (×) button -->
        <Style Selector="Button.remove-mod">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.remove-mod:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.remove-mod:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AttrStrBrush}"/>
        </Style>

    </UserControl.Styles>

    <DockPanel Background="{DynamicResource BgMantleBrush}">

        <!-- ── Top bar ──────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgMantleBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">

                <!-- Title + rarity selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EditorTitle}"
                               Foreground="{DynamicResource AttrIntBrush}" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <!-- Rarity toggle buttons (hidden when editing an existing item) -->
                    <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center"
                                IsVisible="{Binding !IsEditingExisting}">
                        <Button Content="{loc:Tr Editor_RarityNormal}"
                                Classes="rarity-btn"
                                Classes.active="{Binding IsNormal}"
                                Command="{Binding SetNormalCommand}"/>
                        <Button Content="{loc:Tr Editor_RarityMagic}"
                                Classes="rarity-btn"
                                Classes.active="{Binding IsMagic}"
                                Command="{Binding SetMagicCommand}"/>
                        <Button Content="{loc:Tr Editor_RarityRare}"
                                Classes="rarity-btn"
                                Classes.active="{Binding IsRare}"
                                Command="{Binding SetRareCommand}"/>
                        <Button Content="{loc:Tr Editor_RarityUnique}"
                                Classes="rarity-btn"
                                Classes.active="{Binding IsUnique}"
                                Command="{Binding SetUniqueCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Save / Delete / Cancel -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SaveError}"
                               IsVisible="{Binding SaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource AttrStrBrush}" FontSize="13" VerticalAlignment="Center"
                               MaxWidth="200" TextWrapping="Wrap"/>
                    <Button Content="{loc:Tr Editor_BtnSave}"
                            Classes="save-btn"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="{loc:Tr Editor_BtnDelete}"
                            IsVisible="{Binding CanDelete}"
                            Command="{Binding DeleteCommand}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource AttrStrBrush}" BorderThickness="1"
                            Foreground="{DynamicResource AttrStrBrush}"
                            Padding="12,6" FontSize="14"/>
                    <Button Content="{loc:Tr Editor_BtnClose}"
                            Classes="cancel-btn"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main area: Left | Right ─────────────────────────────────────── -->
        <!-- Left column is Auto so it collapses to 0 when the left panel is hidden (IsEditingExisting) -->
        <Grid ColumnDefinitions="Auto,*">

            <!-- ── LEFT: Base selector / Unique selector ─────────────────── -->
            <!-- Hidden when editing an existing item — only mod list shown then -->
            <Border Grid.Column="0"
                    Width="280"
                    IsVisible="{Binding !IsEditingExisting}"
                    Background="{DynamicResource BgMantleBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,10,10,10">

                    <!-- Item level (only for non-unique) -->
                    <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,10"
                                IsVisible="{Binding IsNotUnique}">
                        <TextBlock Text="{loc:Tr Editor_ItemLevel}" Classes="sec-label"/>
                        <TextBox Text="{Binding ItemLevel}" Classes="ed-input"
                                 Watermark="80" Width="80" HorizontalAlignment="Left"/>
                    </StackPanel>


                    <!-- NON-UNIQUE: Category + base picker -->
                    <StackPanel DockPanel.Dock="Top" Spacing="0" IsVisible="{Binding IsNotUnique}">

                        <TextBlock Text="{loc:Tr Editor_Category}" Classes="sec-label"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Classes="ed-combo"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding Converter={x:Static vm:TooltipKindConverter.TranslateItemCategory}}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{loc:Tr Editor_BaseItem}" Classes="sec-label"/>
                        <TextBox Text="{Binding BaseSearch}"
                                 Classes="ed-input"
                                 Watermark="{loc:Tr Editor_SearchBases}"
                                 Margin="0,0,0,4"/>

                        <Border Background="{DynamicResource BgBaseBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                Height="160">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredBases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="eng:BaseItemEntry">
                                            <Button Classes="list-btn"
                                                    Command="{Binding $parent[UserControl].((vm:ItemEditorViewModel)DataContext).SelectBaseCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Name, Converter={x:Static vm:TooltipKindConverter.TranslateItem}}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                    </StackPanel>

                    <!-- UNIQUE: unique search + list -->
                    <StackPanel DockPanel.Dock="Top" Spacing="0" IsVisible="{Binding IsUnique}">

                        <TextBlock Text="{loc:Tr Editor_UniqueItem}" Classes="sec-label"/>
                        <TextBox Text="{Binding UniqueSearch}"
                                 Classes="ed-input"
                                 Watermark="{loc:Tr Editor_SearchUniques}"
                                 Margin="0,0,0,4"/>

                        <Border Background="{DynamicResource BgBaseBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                Height="260">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredUniques}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="eng:UniqueItemEntry">
                                            <Button Classes="list-btn"
                                                    Command="{Binding $parent[UserControl].((vm:ItemEditorViewModel)DataContext).SelectUniqueCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding Name, Converter={x:Static vm:TooltipKindConverter.TranslateUnique}}"
                                                               Foreground="{DynamicResource StatArmourBrush}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding BaseName, Converter={x:Static vm:TooltipKindConverter.TranslateItem}}"
                                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                    </StackPanel>

                    <!-- (Implicits moved to the right-panel mod list for visual unification) -->

                    <!-- Selected base indicator -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0"
                                IsVisible="{Binding SelectedBase, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{loc:Tr Editor_SelectedBase}" Classes="sec-label"/>
                        <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource AttrIntBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="8,4">
                            <TextBlock Text="{Binding SelectedBase.Name, Converter={x:Static vm:TooltipKindConverter.TranslateItem}}"
                                       Foreground="{DynamicResource AttrIntBrush}" FontSize="14" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Selected unique indicator -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0"
                                IsVisible="{Binding SelectedUnique, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{loc:Tr Editor_SelectedUnique}" Classes="sec-label"/>
                        <Border Background="{DynamicResource TooltipStatBoxBgBrush}" BorderBrush="{DynamicResource StatArmourBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="8,4">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding SelectedUnique.Name, Converter={x:Static vm:TooltipKindConverter.TranslateUnique}}"
                                           Foreground="{DynamicResource StatArmourBrush}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedUnique.BaseName, Converter={x:Static vm:TooltipKindConverter.TranslateItem}}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="14"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Panel/><!-- fill -->
                </DockPanel>
            </Border>

            <!-- ── RIGHT: Tooltip-style editor pane ─────────────────────── -->
            <ScrollViewer Grid.Column="1" Padding="12,12"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Border Classes="tooltip-frame" MaxWidth="980" HorizontalAlignment="Stretch">
                    <Border Classes="tooltip-inset" Padding="8,6">
                        <DockPanel>

                <!-- ── Header: item name + base, centred and rarity-coloured ── -->
                <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,4">
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{Binding RarityColor}"
                               FontSize="18" FontWeight="Bold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DisplayBaseName}"
                               IsVisible="{Binding IsUnique}"
                               Foreground="{Binding RarityColor}"
                               FontSize="13"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border DockPanel.Dock="Top" Classes="tooltip-sep"/>

                <!-- ── Item meta strip: Item Level / Quality / Corrupted ── -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,2,0,4">
                    <TextBlock Grid.Column="0"
                               Text="{loc:Tr Editor_Quality}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                               VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1"
                                   Value="{Binding Quality}"
                                   Minimum="0" Maximum="30" Increment="1"
                                   ShowButtonSpinner="True" FormatString="0"
                                   Background="{DynamicResource BgBaseBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                   Foreground="{DynamicResource Brand400Brush}" FontSize="14"
                                   Padding="6,2" Width="110"
                                   VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="%"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                               VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="5"
                              IsChecked="{Binding IsCorrupted}"
                              Foreground="{DynamicResource AttrStrBrush}"
                              FontSize="14" FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Tr Editor_CorruptedHint}">
                        <TextBlock Text="{loc:Tr Editor_Corrupted}"
                                   Foreground="{DynamicResource AttrStrBrush}" FontSize="14" FontWeight="SemiBold"/>
                    </CheckBox>
                    <!-- Corruption-mod picker entry — visible only when the item is corrupted.
                         Distinct red styling to mirror the corruption badge on resulting mod
                         rows so the user can see the entire add-corruption pipeline at a glance. -->
                    <Button Grid.Column="6"
                            IsVisible="{Binding IsCorrupted}"
                            Content="{loc:Tr Editor_AddCorruption}"
                            Command="{Binding OpenCorruptionPickerCommand}"
                            Background="{DynamicResource BgRaisedBrush}"
                            BorderBrush="{DynamicResource CorruptedAccentBrush}" BorderThickness="1"
                            Foreground="{DynamicResource CorruptedAccentBrush}"
                            FontSize="13" FontWeight="Bold"
                            Padding="12,4"
                            VerticalAlignment="Center"/>
                </Grid>
                <Border DockPanel.Dock="Top" Classes="tooltip-sep"/>

                <!-- ── Base stats (Armour / Evasion / ES / Ward / Spirit / Charm Slots) ──
                     Read-only: each row shows the computed effective value (base
                     scaled by base.quality + user Quality + % increased mods),
                     with the intrinsic base value as a grey hint to the right. -->
                <Grid DockPanel.Dock="Top"
                      IsVisible="{Binding HasAnyBaseStat}"
                      ColumnDefinitions="120,80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      Margin="0,2,0,4">

                    <!-- Armour -->
                    <TextBlock Grid.Row="0" Grid.Column="0" IsVisible="{Binding HasArmour}"
                               Text="{loc:Tr Editor_StatArmour}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" IsVisible="{Binding HasArmour}"
                               Text="{Binding EffectiveArmour}"
                               Foreground="{DynamicResource Brand400Brush}" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" IsVisible="{Binding HasArmour}"
                               Text="{Binding DefaultArmourHint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,0,0"/>

                    <!-- Evasion -->
                    <TextBlock Grid.Row="1" Grid.Column="0" IsVisible="{Binding HasEvasion}"
                               Text="{loc:Tr Editor_StatEvasion}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" IsVisible="{Binding HasEvasion}"
                               Text="{Binding EffectiveEvasion}"
                               Foreground="{DynamicResource Brand400Brush}" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" IsVisible="{Binding HasEvasion}"
                               Text="{Binding DefaultEvasionHint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                               VerticalAlignment="Center"/>

                    <!-- Energy Shield -->
                    <TextBlock Grid.Row="2" Grid.Column="0" IsVisible="{Binding HasEnergyShield}"
                               Text="{loc:Tr Editor_StatES}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" IsVisible="{Binding HasEnergyShield}"
                               Text="{Binding EffectiveEnergyShield}"
                               Foreground="{DynamicResource Brand400Brush}" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" IsVisible="{Binding HasEnergyShield}"
                               Text="{Binding DefaultEnergyShieldHint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                               VerticalAlignment="Center"/>

                    <!-- Ward -->
                    <TextBlock Grid.Row="3" Grid.Column="0" IsVisible="{Binding HasWard}"
                               Text="{loc:Tr Editor_StatWard}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" IsVisible="{Binding HasWard}"
                               Text="{Binding EffectiveWard}"
                               Foreground="{DynamicResource Brand400Brush}" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" IsVisible="{Binding HasWard}"
                               Text="{Binding DefaultWardHint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                               VerticalAlignment="Center"/>

                    <!-- Spirit -->
                    <TextBlock Grid.Row="4" Grid.Column="0" IsVisible="{Binding HasSpirit}"
                               Text="{loc:Tr Editor_StatSpirit}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" IsVisible="{Binding HasSpirit}"
                               Text="{Binding DefaultSpirit}"
                               Foreground="{DynamicResource Brand400Brush}" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <!-- Charm Slots -->
                    <TextBlock Grid.Row="5" Grid.Column="0" IsVisible="{Binding HasCharmSlots}"
                               Text="{loc:Tr Editor_StatCharmSlots}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" IsVisible="{Binding HasCharmSlots}"
                               Text="{Binding DefaultCharmSlots}"
                               Foreground="{DynamicResource Brand400Brush}" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Grid>
                <Border DockPanel.Dock="Top" Classes="tooltip-sep" IsVisible="{Binding HasAnyBaseStat}"/>

                <!-- ── Mods + Runes split: toolbar + (collapsible) affix picker + mods list
                     in the left column; runes (when present) in the right column starting
                     at the same vertical level as the mods toolbar. ── -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">

                <!-- LEFT COLUMN: toolbar + affix picker + mods list -->
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

                    <!-- Mods toolbar — Add Mod button + prefix/suffix counter -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="{loc:Tr Editor_Mods}"
                                   Classes="sec-label"
                                   VerticalAlignment="Center" Margin="0"/>
                        <Border Grid.Column="1"
                                IsVisible="{Binding IsNotUnique}"
                                Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="8,3" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding PrefixSuffixLabel}"
                                       Foreground="{DynamicResource ModImplicitBrush}" FontSize="13"/>
                        </Border>
                        <Button Grid.Column="2"
                                IsVisible="{Binding IsNotUnique}"
                                IsEnabled="{Binding CanEditMods}"
                                Content="{loc:Tr Editor_AddMod}"
                                Command="{Binding ToggleAffixPickerCommand}"
                                Classes="rarity-btn"
                                Classes.active="{Binding IsAffixPickerOpen}"
                                Padding="12,4" FontSize="13"/>
                    </Grid>

                    <!-- Affix picker (collapsible, non-unique only) -->
                    <Border Grid.Row="1"
                            IsVisible="{Binding IsAffixPickerOpen}"
                            Height="240"
                            Margin="0,0,0,10"
                            Background="{DynamicResource BgMantleBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            CornerRadius="3">
                        <DockPanel Margin="8">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1">
                                    <Button Content="{loc:Tr Editor_FilterAll}"
                                            Classes="rarity-btn"
                                            Classes.active="{Binding IsFilterAll}"
                                            Command="{Binding SetFilterAllCommand}"
                                            Padding="10,3" FontSize="13"/>
                                    <Button Content="{loc:Tr Editor_FilterPrefix}"
                                            Classes="rarity-btn"
                                            Classes.active="{Binding IsFilterPrefix}"
                                            Command="{Binding SetFilterPrefixCommand}"
                                            Padding="10,3" FontSize="13"/>
                                    <Button Content="{loc:Tr Editor_FilterSuffix}"
                                            Classes="rarity-btn"
                                            Classes.active="{Binding IsFilterSuffix}"
                                            Command="{Binding SetFilterSuffixCommand}"
                                            Padding="10,3" FontSize="13"/>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ModSearch}"
                                         Classes="ed-input"
                                         Watermark="{loc:Tr Editor_SearchMods}"
                                         Margin="8,0,0,0"/>
                            </Grid>
                            <Border Background="{DynamicResource BgBaseBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredAffixes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:AffixEntryViewModel">
                                                <Button Classes="list-btn"
                                                        Command="{Binding AddCommand}"
                                                        ToolTip.Tip="{Binding Entry.AffixName}">
                                                    <Grid ColumnDefinitions="16,26,*,Auto" ColumnSpacing="6">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding TypeLabel}"
                                                                   Foreground="{Binding TypeBrushKey, Converter={x:Static vm:TooltipKindConverter.BrushKeyOrTransparent}}"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Грейд мода (задача #51) -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TierLabel}"
                                                                   ToolTip.Tip="{Binding TierTooltip}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding TranslatedStatText}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                                                                   FontFamily="Cascadia Code,Consolas,monospace"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Entry.Level, StringFormat='Lv {0}'}"
                                                                   Foreground="{DynamicResource BorderStrongBrush}" FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- ── Dedicated CORRUPTION picker (separate from the affix picker) ──
                         Crimson-tinted shell so the user can see at a glance that this is
                         the dangerous pipeline; uses CorruptionSearch + FilteredCorruptionAffixes. -->
                    <Border Grid.Row="1"
                            IsVisible="{Binding IsCorruptionPickerOpen}"
                            Height="240"
                            Margin="0,0,0,10"
                            Background="{DynamicResource CorruptedPickerBgBrush}"
                            BorderBrush="{DynamicResource CorruptedAccentBrush}" BorderThickness="1"
                            CornerRadius="3">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{loc:Tr Editor_CorruptionPickerHeader}"
                                       Foreground="{DynamicResource CorruptedAccentBrush}" FontSize="12" FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <TextBox DockPanel.Dock="Top"
                                     Text="{Binding CorruptionSearch}"
                                     Classes="ed-input"
                                     Watermark="{loc:Tr Editor_SearchCorruption}"
                                     Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource BgBaseBrush}"
                                    BorderBrush="{DynamicResource CorruptedAccentBrush}" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredCorruptionAffixes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:AffixEntryViewModel">
                                                <Button Classes="list-btn"
                                                        Command="{Binding AddCommand}"
                                                        ToolTip.Tip="{Binding Entry.AffixName}">
                                                    <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="6">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="C"
                                                                   Foreground="{DynamicResource CorruptedAccentBrush}"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TranslatedStatText}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                                                                   FontFamily="Cascadia Code,Consolas,monospace"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Entry.Level, StringFormat='Lv {0}'}"
                                                                   Foreground="{DynamicResource BorderStrongBrush}" FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Mods list — Grid.Row=2 fills the remaining height in the left column. -->
                    <Border Grid.Row="2"
                            Padding="0,0,8,0"
                            Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- Empty state -->
                            <TextBlock IsVisible="{Binding !ExplicitMods.Count, FallbackValue=False}"
                                       Text="{loc:Tr Editor_NoMods}"
                                       Foreground="{DynamicResource BorderStrongBrush}" FontSize="14"
                                       HorizontalAlignment="Center"
                                       Padding="12,16"
                                       TextWrapping="Wrap"/>

                            <!-- Implicit + explicit mods (all rendered through ExplicitMods with IsImplicit flag) -->
                            <ItemsControl ItemsSource="{Binding ExplicitMods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ExplicitModViewModel">
                                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                                Background="{Binding RowBackgroundBrushKey, Converter={x:Static vm:TooltipKindConverter.BrushKeyOrTransparent}}"
                                                Padding="6,5,6,5">
                                            <Grid ColumnDefinitions="3,26,*,Auto,Auto" ColumnSpacing="8">
                                                <!-- Corruption accent stripe — vivid red left edge for corruption mods only -->
                                                <Border Grid.Column="0"
                                                        Width="3"
                                                        IsVisible="{Binding IsCorruption}"
                                                        Background="{DynamicResource CorruptedAccentBrush}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Stretch"/>
                                                <!-- Type badge (P / S / I / C / empty) -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TypeBadgeLabel}"
                                                           ToolTip.Tip="{Binding TierTooltip}"
                                                           Foreground="{Binding TypeBadgeBrushKey, Converter={x:Static vm:TooltipKindConverter.BrushKeyOrTransparent}}"
                                                           FontSize="14" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Top"
                                                           Margin="0,2,0,0"/>

                                                <!-- Mod text + slider -->
                                                <StackPanel Grid.Column="2" Spacing="4">

                                                    <!-- Plain text -->
                                                    <TextBlock IsVisible="{Binding !HasColoredValue}"
                                                               Text="{Binding TranslatedText}"
                                                               Foreground="{DynamicResource RarityMagicBrush}" FontSize="14" FontWeight="Medium"
                                                               TextWrapping="Wrap"/>

                                                    <!-- Split text with colored number -->
                                                    <StackPanel IsVisible="{Binding HasColoredValue}"
                                                                Orientation="Horizontal" Spacing="0">
                                                        <TextBlock Text="{Binding TranslatedPartBefore}"
                                                                   Foreground="{DynamicResource RarityMagicBrush}" FontSize="14" FontWeight="Medium"/>
                                                        <TextBlock Text="{Binding PartNumber}"
                                                                   Foreground="{DynamicResource Brand400Brush}" FontSize="14" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding TranslatedPartAfter}"
                                                                   Foreground="{DynamicResource RarityMagicBrush}" FontSize="14" FontWeight="Medium"/>
                                                    </StackPanel>

                                                    <!-- Slider for numeric ranges. Margin on the slider gives the
                                                         thumb room to render past the track ends without being
                                                         clipped by the parent panel padding. -->
                                                    <Grid IsVisible="{Binding HasSlider}"
                                                          ColumnDefinitions="Auto,*,Auto"
                                                          Margin="0,3,4,1">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding SliderMin, StringFormat='{}{0:0.##}'}"
                                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0"/>
                                                        <Slider Grid.Column="1"
                                                                Minimum="{Binding SliderMin}"
                                                                Maximum="{Binding SliderMax}"
                                                                Value="{Binding SliderValue}"
                                                                TickFrequency="{Binding SliderTick}"
                                                                IsSnapToTickEnabled="True"
                                                                HorizontalAlignment="Stretch"
                                                                Margin="0,0,0,0"
                                                                VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding SliderMax, StringFormat='{}{0:0.##}'}"
                                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="10,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Чип грейда: «T4 / 10» (задача #51) -->
                                                <Border Grid.Column="3"
                                                        IsVisible="{Binding HasTierChip}"
                                                        ToolTip.Tip="{Binding TierTooltip}"
                                                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                                        CornerRadius="3" Padding="5,0,5,1"
                                                        VerticalAlignment="Top" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding TierChipText}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="11" FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- × Remove (only for removable mods) -->
                                                <Button Grid.Column="4"
                                                        IsVisible="{Binding IsRemovable}"
                                                        Content="✕"
                                                        Classes="remove-mod"
                                                        Command="{Binding RemoveCommand}"
                                                        VerticalAlignment="Top"
                                                        Margin="0,2,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                </Grid> <!-- close LEFT COLUMN Grid (toolbar + picker + mods) -->

                <!-- ── Runes / Idols column (right) — visible if the base has rune sockets.
                     Lives in Grid.Column=2 of the outer mods+runes Grid, so its top edge
                     aligns with the mods toolbar — not pushed below it. -->
                <Border Grid.Column="2"
                        IsVisible="{Binding HasRuneSockets}"
                        Width="260"
                        Background="Transparent"
                        BorderBrush="{DynamicResource TooltipBorderBrownBrush}" BorderThickness="1,0,0,0"
                        Padding="12,0,0,0"
                        Margin="0,0,0,0">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Tr Editor_Runes}"
                                       Classes="sec-label"
                                       VerticalAlignment="Center" Margin="0"/>
                            <Button Grid.Column="1"
                                    Content="{loc:Tr Editor_AddRune}"
                                    Command="{Binding AddRuneSocketCommand}"
                                    IsEnabled="{Binding CanAddRune}"
                                    Classes="rarity-btn"
                                    Padding="10,3" FontSize="13"/>
                        </Grid>

                        <TextBlock IsVisible="{Binding !HasAnyRunes}"
                                   Text="{loc:Tr Editor_NoRunes}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                   FontStyle="Italic"/>

                        <ItemsControl ItemsSource="{Binding RuneSockets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:RuneSocketViewModel">
                                    <Border Background="{DynamicResource BgBaseBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                            Margin="0,3,0,0"
                                            Padding="6,4">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Index, StringFormat='#{0}'}"
                                                       Foreground="{DynamicResource ModEnchantBrush}" FontSize="13" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       MinWidth="22"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <ComboBox ItemsSource="{Binding AvailableRunes}"
                                                          SelectedItem="{Binding SelectedRune}"
                                                          Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                                          HorizontalAlignment="Stretch"
                                                          IsEnabled="{Binding $parent[UserControl].((vm:ItemEditorViewModel)DataContext).CanEditMods}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate DataType="eng:RuneEntry">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <!-- Augment-type badge: Rune / Soul Core / Idol / … -->
                                                                <Border Background="{Binding AugType, Converter={x:Static vm:TooltipKindConverter.RuneAugTypeBrush}}"
                                                                        CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding AugType, Converter={x:Static vm:TooltipKindConverter.RuneAugTypeLabel}}"
                                                                               FontSize="10" FontWeight="Bold"
                                                                               Foreground="{DynamicResource TextOnBadgeBrush}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Name, Converter={x:Static vm:TooltipKindConverter.TranslateRune}}"
                                                                           FontSize="13"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Text="{Binding ModSummary}"
                                                           IsVisible="{Binding !IsEmpty}"
                                                           Foreground="{DynamicResource RarityMagicBrush}" FontSize="14"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="✕"
                                                    Classes="remove-mod"
                                                    Command="{Binding $parent[UserControl].((vm:ItemEditorViewModel)DataContext).RemoveRuneSocketCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding $parent[UserControl].((vm:ItemEditorViewModel)DataContext).CanEditMods}"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                </Grid> <!-- close mods+runes grid -->

                        </DockPanel>
                    </Border>
                </Border>
            </ScrollViewer>

        </Grid>

    </DockPanel>

</UserControl>
