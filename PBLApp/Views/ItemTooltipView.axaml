<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PBLApp.ViewModels"
             xmlns:ctl="using:PBLApp.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="700"
             x:Class="PBLApp.Views.ItemTooltipView"
             x:DataType="vm:ItemTooltipViewModel">

    <UserControl.Styles>
        <!-- Hybrid tooltip: house-style card (BgMantle + BorderSubtle, rounded) with a
             left rarity-accent stripe; PoE-authentic text colours come from the segments. -->
        <Style Selector="Border.tooltip-frame">
            <Setter Property="Background" Value="{DynamicResource BgMantleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <!-- A single Inline-driven TextBlock per line so long titles wrap inside the
             column rather than overflowing. WrapPanel of separate TextBlocks doesn't
             word-wrap; only the row-of-runs wraps. -->
        <Style Selector="TextBlock.tt-line">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- Бейдж грейда мода: «P4» / «S1» / «I» слева от строки мода (задача #51) -->
        <Style Selector="Border.tt-badge">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,0,4,1"/>
            <Setter Property="Margin" Value="0,2,7,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="MinWidth" Value="24"/>
        </Style>
        <Style Selector="Border.tt-badge > TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.tt-sep">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBlock.tt-delta-header">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Per-line DataTemplate logic: separator vs text -->
    </UserControl.Styles>

    <Border Classes="tooltip-frame">
        <Grid ColumnDefinitions="3,*">
            <!-- left rarity-accent stripe -->
            <Rectangle Grid.Column="0"
                       Fill="{Binding RarityColorHex, Converter={x:Static vm:TooltipKindConverter.HexToBrush}}"/>
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="14,10">
                <Grid ColumnDefinitions="*,Auto,*">
                    <!-- ── Item info (block 1) ─────────────────────────────────── -->
                    <ItemsControl Grid.Column="0"
                                  ItemsSource="{Binding ItemLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TooltipLineVm">
                                <Grid Margin="0,1" ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" Grid.ColumnSpan="2"
                                            Classes="tt-sep"
                                            IsVisible="{Binding Kind, Converter={x:Static vm:TooltipKindConverter.IsSeparator}}"/>
                                    <!-- Грейд мода -->
                                    <Border Grid.Column="0"
                                            Classes="tt-badge"
                                            IsVisible="{Binding HasBadge}"
                                            ToolTip.Tip="{Binding BadgeTooltip}"
                                            BorderBrush="{Binding BadgeBrushKey, Converter={x:Static vm:TooltipKindConverter.BrushKeyOrTransparent}}">
                                        <TextBlock Text="{Binding BadgeText}"
                                                   Foreground="{Binding BadgeBrushKey, Converter={x:Static vm:TooltipKindConverter.BrushKeyOrTransparent}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Classes="tt-line"
                                               IsVisible="{Binding Kind, Converter={x:Static vm:TooltipKindConverter.IsText}}"
                                               ctl:InlinesHelper.ItemSegments="{Binding Segments}"
                                               FontSize="{Binding Size, Converter={x:Static vm:TooltipKindConverter.ScaleSizeItem}}"
                                               FontWeight="{Binding Size, Converter={x:Static vm:TooltipKindConverter.WeightForSize}}"
                                               LineHeight="{Binding Size, Converter={x:Static vm:TooltipKindConverter.LineHeightForSize}}"
                                               HorizontalAlignment="{Binding Centered, Converter={x:Static vm:TooltipKindConverter.CenterOrLeft}}"
                                               TextAlignment="{Binding Centered, Converter={x:Static vm:TooltipKindConverter.CenterOrLeftTextAlignment}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── Vertical divider (only when delta block exists) ─────── -->
                    <Border Grid.Column="1"
                            Width="1"
                            Margin="14,0,14,0"
                            Background="{DynamicResource BorderSubtleBrush}"
                            IsVisible="{Binding HasDelta}"/>

                    <!-- ── Equip / unequip delta (block ≥ 2) ────────────────────── -->
                    <StackPanel Grid.Column="2"
                                IsVisible="{Binding HasDelta}">
                        <ItemsControl ItemsSource="{Binding DeltaLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TooltipLineVm">
                                    <Grid Margin="0,1">
                                        <Border Classes="tt-sep"
                                                IsVisible="{Binding Kind, Converter={x:Static vm:TooltipKindConverter.IsSeparator}}"/>
                                        <TextBlock Classes="tt-line"
                                                   IsVisible="{Binding Kind, Converter={x:Static vm:TooltipKindConverter.IsText}}"
                                                   ctl:InlinesHelper.ItemSegments="{Binding Segments}"
                                                   FontSize="{Binding Size, Converter={x:Static vm:TooltipKindConverter.ScaleSize}}"
                                                   FontWeight="{Binding Size, Converter={x:Static vm:TooltipKindConverter.WeightForSize}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
