<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PBLApp.ViewModels"
             xmlns:conv="using:PBLApp.Converters"
             xmlns:engine="using:PBLEngine"
             xmlns:ctl="using:PBLApp.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="PBLApp.Views.ConfigTabView"
             x:DataType="vm:ConfigTabViewModel">

    <UserControl.Resources>
        <conv:TypeMatchConverter x:Key="TypeMatch" />
        <StreamGeometry x:Key="IconChevronDown">M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Card (mirrors the Calcs compact card) -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource BgMantleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.card-head">
            <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="PathIcon.chev">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="PathIcon.chev.collapsed">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
        </Style>
        <Style Selector="TextBlock.opt-label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Compact inputs to match the dense rows -->
        <Style Selector="ComboBox.opt-input">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style Selector="TextBox.opt-input">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="12" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ctl:MasonryPanel ColumnCount="4" ColumnSpacing="8" RowSpacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConfigSectionViewModel">
                    <Border Classes="card">
                        <StackPanel>
                            <!-- Header (click to collapse) -->
                            <Border Classes="card-head"
                                    BorderThickness="3,0,0,0"
                                    BorderBrush="{DynamicResource Brand400Brush}"
                                    PointerPressed="SectionHeader_PointerPressed">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Grid.Column="0" Classes="chev"
                                              Classes.collapsed="{Binding !IsExpanded}"
                                              Data="{StaticResource IconChevronDown}"
                                              Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brand400Brush}" />
                                </Grid>
                            </Border>
                            <!-- Options -->
                            <ItemsControl ItemsSource="{Binding Options}"
                                          IsVisible="{Binding IsExpanded}"
                                          Margin="0,4,0,5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConfigOptionViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="11,3" MinHeight="24">

                                            <!-- label (hidden for the full-width multi-line 'text' editor) -->
                                            <TextBlock Grid.Column="0"
                                                       Classes="opt-label"
                                                       Text="{Binding Label}"
                                                       IsVisible="{Binding Type, Converter={StaticResource TypeMatch}, ConverterParameter=check|list|count|integer|float|countAllowZero}"
                                                       Margin="0,0,8,0" />

                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding IsChecked}"
                                                      IsVisible="{Binding Type, Converter={StaticResource TypeMatch}, ConverterParameter=check}"
                                                      HorizontalAlignment="Right" />

                                            <ComboBox Grid.Column="1" Classes="opt-input"
                                                      ItemsSource="{Binding ListOptions}"
                                                      SelectedItem="{Binding SelectedItem}"
                                                      IsVisible="{Binding Type, Converter={StaticResource TypeMatch}, ConverterParameter=list}"
                                                      HorizontalAlignment="Right">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="engine:ConfigListItem">
                                                        <TextBlock Text="{Binding Label}" FontSize="12" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBox Grid.Column="1" Classes="opt-input"
                                                     Text="{Binding TextValue}"
                                                     IsVisible="{Binding Type, Converter={StaticResource TypeMatch}, ConverterParameter=count|integer|float|countAllowZero}"
                                                     Width="84"
                                                     HorizontalAlignment="Right" />

                                            <!-- Custom Modifiers: full-width multi-line editor -->
                                            <TextBox Grid.Column="0" Grid.ColumnSpan="2" Classes="opt-input"
                                                     Text="{Binding TextValue}"
                                                     IsVisible="{Binding Type, Converter={StaticResource TypeMatch}, ConverterParameter=text}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="150"
                                                     FontFamily="Cascadia Code,Consolas,monospace"
                                                     HorizontalAlignment="Stretch" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

</UserControl>
