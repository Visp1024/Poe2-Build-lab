<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PBLApp.ViewModels"
             xmlns:loc="using:PBLApp.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="PBLApp.Views.TraderTabView"
             x:DataType="vm:TraderTabViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource BgMantleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.col-head">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="10">

        <!-- ── Шапка: лига, логин, суммарная примерка ─────────────────────── -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="10" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="{loc:Tr Trader_League}" Classes="muted"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" MinWidth="220" Height="36"
                          ItemsSource="{Binding Leagues}"
                          SelectedItem="{Binding SelectedLeague, Mode=TwoWay}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Classes="muted" VerticalAlignment="Center"
                               Text="{Binding LeagueLoadError}"
                               IsVisible="{Binding LeagueLoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding TotalTryOnText}"
                               IsVisible="{Binding HasTryOns}" />
                </StackPanel>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"
                           Text="{Binding AccountName}"
                           IsVisible="{Binding IsLoggedIn}" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                    <Button Content="{loc:Tr Trader_Login}" Command="{Binding LoginCommand}"
                            IsVisible="{Binding !IsLoggedIn}" />
                    <Button Content="{loc:Tr Trader_Logout}" Command="{Binding LogoutCommand}"
                            IsVisible="{Binding IsLoggedIn}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Панель весов и цены ────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="{loc:Tr Trader_PresetDps}"
                        Command="{Binding ApplyPresetCommand}" CommandParameter="dps" />
                <Button Content="{loc:Tr Trader_PresetEhp}"
                        Command="{Binding ApplyPresetCommand}" CommandParameter="ehp" />
                <Button Content="{loc:Tr Trader_PresetBalance}"
                        Command="{Binding ApplyPresetCommand}" CommandParameter="balance" />
                <Button Content="{Binding WeightsButtonText}" Margin="12,0,0,0">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="420" Spacing="6">
                                <TextBox Text="{Binding WeightSearch, Mode=TwoWay}"
                                         Watermark="{loc:Tr Trader_WeightSearch}" />
                                <ScrollViewer MaxHeight="420">
                                    <ItemsControl ItemsSource="{Binding FilteredWeightStats}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TraderWeightEntryViewModel">
                                                <Grid ColumnDefinitions="*,120" Margin="0,1">
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <NumericUpDown Grid.Column="1"
                                                                   Value="{Binding WeightMult, Mode=TwoWay}"
                                                                   Minimum="0" Maximum="1" Increment="0.05"
                                                                   FormatString="0.0#" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Content="{loc:Tr Trader_WeightReset}"
                                        Command="{Binding ResetWeightsCommand}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Text="{loc:Tr Trader_MaxPrice}" Classes="muted"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox Text="{Binding MaxPrice, Mode=TwoWay}" Width="80" Watermark="—" />
                <ComboBox ItemsSource="{Binding CurrencyNames}"
                          SelectedIndex="{Binding MaxPriceCurrencyIndex, Mode=TwoWay}"
                          MinWidth="190" />
            </StackPanel>
        </Border>

        <!-- ── Строки слотов ──────────────────────────────────────────────── -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TraderSlotRowViewModel">
                        <Border Classes="card" Margin="0,0,0,6" Padding="10,8">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="160,*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center">
                                        <TextBlock Classes="muted" Text="{Binding CurrentItemName}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Margin="0,0,6,0"
                                            Content="{loc:Tr Trader_FindUpgrades}"
                                            Command="{Binding SearchCommand}"
                                            IsEnabled="{Binding !IsBusy}" />
                                    <Button Grid.Column="3" Margin="0,0,6,0"
                                            Content="{loc:Tr Trader_Cancel}"
                                            Command="{Binding CancelCommand}"
                                            IsVisible="{Binding IsBusy}" />
                                    <Button Grid.Column="4"
                                            Content="{loc:Tr Trader_OpenSite}"
                                            Command="{Binding OpenOnSiteCommand}" />
                                </Grid>

                                <!-- Результаты -->
                                <ItemsControl ItemsSource="{Binding Results}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TraderResultViewModel">
                                            <Grid ColumnDefinitions="230,90,90,90,150,Auto,Auto"
                                                  Margin="0,2"
                                                  ToolTip.Tip="{Binding Listing.ItemText}">
                                                <TextBlock Grid.Column="0" Text="{Binding PriceText}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           Text="{Binding DpsDiff, StringFormat='+0.#;-0.#;0'}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                           Text="{Binding EhpDiff, StringFormat='+0.#;-0.#;0'}" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                           Classes="muted"
                                                           Text="{Binding ValuePerDiv, StringFormat=0.#}" />
                                                <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                                           Classes="muted"
                                                           Text="{Binding Listing.Seller}" />
                                                <Button Grid.Column="5" Margin="0,0,6,0"
                                                        Content="{loc:Tr Trader_TryOn}"
                                                        Command="{Binding TryOnCommand}"
                                                        IsEnabled="{Binding !IsTriedOn}" />
                                                <Button Grid.Column="6"
                                                        Content="{loc:Tr Trader_Whisper}"
                                                        Command="{Binding CopyWhisperCommand}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
