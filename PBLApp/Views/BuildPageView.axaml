<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PBLApp.ViewModels"
             xmlns:loc="using:PBLApp.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="PBLApp.Views.BuildPageView"
             x:DataType="vm:BuildPageViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header bar -->
        <Border Grid.Row="0" Padding="8,10" Background="#1E1E2E">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Button Content="{loc:Tr Btn_Back}"
                            Command="{Binding BackCommand}" />
                    <TextBlock Text="{Binding BuildName}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#CDD6F4"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="{loc:Tr Tab_Notes}"
                            Click="OpenNotes_Click"
                            IsVisible="{Binding NotesTab, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button Content="{loc:Tr Tab_Config}"
                            Click="OpenSettings_Click"
                            IsVisible="{Binding ConfigTab, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button Content="{loc:Tr Tab_ImportExport}"
                            Click="OpenImportExport_Click"
                            IsVisible="{Binding ImportTab, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{loc:Tr List_Language}"
                               Foreground="#585B70" FontSize="11"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="LangCombo"
                              MinWidth="60"
                              Background="#313244" Foreground="#CDD6F4"
                              BorderBrush="#45475A" FontSize="12">
                        <ComboBoxItem Content="EN" Tag="en" />
                        <ComboBoxItem Content="RU" Tag="ru" />
                    </ComboBox>
                    <Button Content="{loc:Tr Btn_Save}"
                            Command="{Binding SaveBuildCommand}"
                            IsVisible="{Binding Build, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar summary strip (visible when build is loaded) -->
        <Border Grid.Row="1" Background="#181825" Padding="8,6"
                IsVisible="{Binding Build, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Tr Sidebar_DPS}" Foreground="#585B70" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.TotalDps, StringFormat={}{0:N0}}"
                               Foreground="#F38BA8" FontSize="12" FontWeight="Bold"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Tr Sidebar_Life}" Foreground="#585B70" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.Life, StringFormat={}{0:N0}}"
                               Foreground="#A6E3A1" FontSize="12" FontWeight="Bold"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Tr Sidebar_ES}" Foreground="#585B70" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.EnergyShield, StringFormat={}{0:N0}}"
                               Foreground="#89DCEB" FontSize="12" FontWeight="Bold"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Tr Sidebar_Mana}" Foreground="#585B70" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.Mana, StringFormat={}{0:N0}}"
                               Foreground="#89B4FA" FontSize="12" FontWeight="Bold"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Tr Sidebar_Armour}" Foreground="#585B70" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.Armour, StringFormat={}{0:N0}}"
                               Foreground="#FAB387" FontSize="12" FontWeight="Bold"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Tr Sidebar_Eva}" Foreground="#585B70" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.Evasion, StringFormat={}{0:N0}}"
                               Foreground="#CBA6F7" FontSize="12" FontWeight="Bold"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="2">

            <!-- Loading spinner -->
            <StackPanel IsVisible="{Binding IsLoading}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="200" />
                <TextBlock Text="{loc:Tr Page_Loading}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error message -->
            <TextBlock IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding LoadError}"
                       Foreground="Red"
                       Margin="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <!-- Tab control (shown when loaded and no error) -->
            <TabControl IsVisible="{Binding Build, Converter={x:Static ObjectConverters.IsNotNull}}"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                        Margin="0">
                <TabControl.Styles>
                    <Style Selector="Button.popout">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="#585B70" />
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style Selector="Button.popout:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#313244" />
                        <Setter Property="Foreground" Value="#89B4FA" />
                    </Style>
                </TabControl.Styles>

                <!-- Items tab -->
                <TabItem IsVisible="{Binding !IsItemsPoppedOut}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Tab_Items}" VerticalAlignment="Center" />
                            <Button Classes="popout" Content="&#x2197;" Tag="Items"
                                    Click="PopOutTab_Click"
                                    ToolTip.Tip="{loc:Tr Tab_PopOut}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Content="{Binding ItemsTab}" />
                </TabItem>

                <!-- Tree tab -->
                <TabItem IsVisible="{Binding !IsTreePoppedOut}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Tab_Tree}" VerticalAlignment="Center" />
                            <Button Classes="popout" Content="&#x2197;" Tag="Tree"
                                    Click="PopOutTab_Click"
                                    ToolTip.Tip="{loc:Tr Tab_PopOut}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Content="{Binding TreeTab}" />
                </TabItem>

                <!-- Skills tab -->
                <TabItem IsVisible="{Binding !IsSkillsPoppedOut}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Tab_Skills}" VerticalAlignment="Center" />
                            <Button Classes="popout" Content="&#x2197;" Tag="Skills"
                                    Click="PopOutTab_Click"
                                    ToolTip.Tip="{loc:Tr Tab_PopOut}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Content="{Binding SkillsTab}" />
                </TabItem>

                <!-- Calcs tab -->
                <TabItem IsVisible="{Binding !IsCalcsPoppedOut}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Tab_Calcs}" VerticalAlignment="Center" />
                            <Button Classes="popout" Content="&#x2197;" Tag="Calcs"
                                    Click="PopOutTab_Click"
                                    ToolTip.Tip="{loc:Tr Tab_PopOut}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Content="{Binding CalcsTab}" />
                </TabItem>

                <!-- Config tab -->
            </TabControl>

        </Grid>

    </Grid>

</UserControl>
