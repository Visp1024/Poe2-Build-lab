<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PBLApp.ViewModels"
             xmlns:loc="using:PBLApp.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="PBLApp.Views.BuildPageView"
             x:DataType="vm:BuildPageViewModel"
             Background="{DynamicResource BgBaseBrush}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header bar -->
        <Border Grid.Row="0"
                Padding="{StaticResource PaddingHeaderCompact}"
                Background="{DynamicResource BgMantleBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Border.Styles>
                <!-- Combos keep the default Suki look (same as the main-skill selector
                     in the stats strip) and stretch to the row height like the buttons.
                     Suki's ComboBox template wraps the field in a hardcoded Padding="5"
                     border; the negative margin cancels it so the visible field spans
                     the full row height, flush with the buttons. -->
                <Style Selector="ComboBox">
                    <Setter Property="Margin" Value="0,-5"/>
                </Style>
                <Style Selector="TextBlock.caption">
                    <Setter Property="FontSize" Value="13"/>
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Button Content="{loc:Tr Btn_Back}"
                            Command="{Binding BackCommand}" />
                    <TextBlock Text="{Binding BuildName}"
                               Classes="h2"
                               VerticalAlignment="Center"
                               Margin="0,3,0,0" />

                    <!-- Class / ascendancy selectors (moved here from the TreeTab toolbar) -->
                    <Border Width="1" Height="22"
                            Background="{DynamicResource BorderStrongBrush}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding TreeTab, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding TreeTab, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{loc:Tr Tree_Class}" Classes="caption" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding TreeTab.Classes}"
                                  SelectedItem="{Binding TreeTab.SelectedClass}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  Width="200"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding TreeTab, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{loc:Tr Tree_Asc}" Classes="caption" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding TreeTab.AvailableAscendancies}"
                                  SelectedItem="{Binding TreeTab.SelectedAscend}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  Width="220"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="{loc:Tr Tab_Notes}"
                            Click="OpenNotes_Click"
                            IsVisible="{Binding NotesTab, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <!-- Tab_Config moved into the tab strip (left side, separated) — see PopOutTab-row below. -->
                    <Button Content="{loc:Tr Tab_ImportExport}"
                            Click="OpenImportExport_Click"
                            IsVisible="{Binding ImportTab, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Border Width="1" Height="22"
                            Background="{DynamicResource BorderStrongBrush}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Tr List_Language}"
                               Classes="caption"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="LangCombo" MinWidth="60">
                        <ComboBoxItem Content="EN" Tag="en" />
                        <ComboBoxItem Content="RU" Tag="ru" />
                    </ComboBox>
                    <Border Width="1" Height="22"
                            Background="{DynamicResource BorderStrongBrush}"
                            VerticalAlignment="Center" />
                    <Button Content="{loc:Tr Btn_Save}"
                            Classes="accent"
                            Command="{Binding SaveBuildCommand}"
                            IsVisible="{Binding Build, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar summary strip + unified main-skill selector (visible when build is loaded).
             Stats on the left, vertical divider, then main-skill selector. Replaces the
             per-tab selector in CalcsTabView and the "Set as Main" button in SkillsTabView. -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="{StaticResource PaddingSidebar}"
                IsVisible="{Binding Build, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border.Styles>
                <!-- Same trick as the header: cancel the hardcoded Padding="5" inside
                     Suki's ComboBox template so the field fills the row height. -->
                <Style Selector="ComboBox">
                    <Setter Property="Margin" Value="0,-5"/>
                </Style>
            </Border.Styles>
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Tr Sidebar_DPS}" Classes="caption" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.TotalDps, StringFormat={}{0:N0}}"
                               Classes="num-md"
                               Foreground="{DynamicResource StatDpsBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Tr Sidebar_Life}" Classes="caption" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.Life, StringFormat={}{0:N0}}"
                               Classes="num-md"
                               Foreground="{DynamicResource StatLifeBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Tr Sidebar_ES}" Classes="caption" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.EnergyShield, StringFormat={}{0:N0}}"
                               Classes="num-md"
                               Foreground="{DynamicResource StatEsBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Runic Ward — shown only for builds that stack it (HasWard). -->
                <StackPanel Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding Build.HasWard}">
                    <TextBlock Text="{loc:Tr Sidebar_Ward}" Classes="caption" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.Ward, StringFormat={}{0:N0}}"
                               Classes="num-md"
                               Foreground="{DynamicResource StatWardBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Tr Sidebar_Mana}" Classes="caption" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.Mana, StringFormat={}{0:N0}}"
                               Classes="num-md"
                               Foreground="{DynamicResource StatManaBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Tr Sidebar_Armour}" Classes="caption" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.Armour, StringFormat={}{0:N0}}"
                               Classes="num-md"
                               Foreground="{DynamicResource StatArmourBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Tr Sidebar_Eva}" Classes="caption" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.Evasion, StringFormat={}{0:N0}}"
                               Classes="num-md"
                               Foreground="{DynamicResource StatEvasionBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding !Build.HasDarkness}">
                    <TextBlock Text="{loc:Tr Sidebar_Spirit}" Classes="caption" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.Spirit, StringFormat={}{0:N0}}"
                               Classes="num-md"
                               Foreground="{DynamicResource AttrIntBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Darkness replaces Spirit for Acolyte of Chayula (Embrace the Darkness). -->
                <StackPanel Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding Build.HasDarkness}">
                    <TextBlock Text="{loc:Tr Sidebar_Darkness}" Classes="caption" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Build.Darkness, StringFormat={}{0:N0}}"
                               Classes="num-md"
                               Foreground="{DynamicResource StatDarknessBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Divider between stats and main-skill selector -->
                <Border Width="1"
                        Background="{DynamicResource BorderStrongBrush}"
                        Margin="4,2"
                        IsVisible="{Binding CalcsTab, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- Unified main-skill selector. Binds to CalcsTab's SkillGroups/SelectedSkillGroup,
                     which drives main skill via OnSelectedSkillGroupChanged → SetActiveSkillGroup. -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding CalcsTab, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="&#x2605;"
                               Foreground="{DynamicResource Brand400Brush}"
                               FontSize="14"
                               VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding CalcsTab.SkillGroups}"
                              SelectedItem="{Binding CalcsTab.SelectedSkillGroup}"
                              MinWidth="240">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SkillGroupDisplayVm">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding CalcsTab.ActiveSkills}"
                              SelectedItem="{Binding CalcsTab.SelectedActiveSkill}"
                              IsVisible="{Binding CalcsTab.HasMultipleActiveSkills}"
                              MinWidth="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActiveSkillDisplayVm">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="2">

            <!-- Loading spinner -->
            <StackPanel IsVisible="{Binding IsLoading}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="200" />
                <TextBlock Text="{loc:Tr Page_Loading}" Classes="body" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error message -->
            <TextBlock IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding LoadError}"
                       Foreground="{DynamicResource DangerBrush}"
                       Margin="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <!-- Tab strip + content. All five buttons (Items/Tree/Skills/Calcs/Настройки)
                 share the same brand-tinted look; the first four toggle SelectedTabIndex
                 via RadioButton (IsChecked → bool-tab binding), Настройки opens its own
                 window on click. -->
            <DockPanel IsVisible="{Binding Build, Converter={x:Static ObjectConverters.IsNotNull}}">
                <DockPanel.Styles>
                    <Style Selector="RadioButton.tab,Button.tab">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Padding" Value="14,8" />
                        <Setter Property="Margin" Value="0,0,2,0" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                    </Style>
                    <!-- Hide the default RadioButton radio indicator so it looks like a flat tab button. -->
                    <Style Selector="RadioButton.tab">
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Name="RootBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="RadioButton.tab:pointerover /template/ Border#RootBorder">
                        <Setter Property="Background" Value="{DynamicResource Brand100Brush}" />
                    </Style>
                    <Style Selector="RadioButton.tab:pointerover">
                        <Setter Property="Foreground" Value="{DynamicResource Brand400Brush}" />
                    </Style>
                    <Style Selector="RadioButton.tab:checked">
                        <Setter Property="Foreground" Value="{DynamicResource Brand500Brush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brand500Brush}" />
                    </Style>
                    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource Brand100Brush}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brand400Brush}" />
                    </Style>
                    <Style Selector="Button.popout">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style Selector="Button.popout:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brand500Brush}" />
                    </Style>
                </DockPanel.Styles>

                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <RadioButton Classes="tab" GroupName="MainTabs"
                                     IsChecked="{Binding IsItemsTab, Mode=TwoWay}"
                                     IsVisible="{Binding !IsItemsPoppedOut}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Tab_Items}" VerticalAlignment="Center" />
                                <Button Classes="popout" Content="&#x2197;" Tag="Items"
                                        Click="PopOutTab_Click"
                                        ToolTip.Tip="{loc:Tr Tab_PopOut}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="tab" GroupName="MainTabs"
                                     IsChecked="{Binding IsTreeTab, Mode=TwoWay}"
                                     IsVisible="{Binding !IsTreePoppedOut}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Tab_Tree}" VerticalAlignment="Center" />
                                <Button Classes="popout" Content="&#x2197;" Tag="Tree"
                                        Click="PopOutTab_Click"
                                        ToolTip.Tip="{loc:Tr Tab_PopOut}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="tab" GroupName="MainTabs"
                                     IsChecked="{Binding IsSkillsTab, Mode=TwoWay}"
                                     IsVisible="{Binding !IsSkillsPoppedOut}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Tab_Skills}" VerticalAlignment="Center" />
                                <Button Classes="popout" Content="&#x2197;" Tag="Skills"
                                        Click="PopOutTab_Click"
                                        ToolTip.Tip="{loc:Tr Tab_PopOut}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="tab" GroupName="MainTabs"
                                     IsChecked="{Binding IsCalcsTab, Mode=TwoWay}"
                                     IsVisible="{Binding !IsCalcsPoppedOut}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Tab_Calcs}" VerticalAlignment="Center" />
                                <Button Classes="popout" Content="&#x2197;" Tag="Calcs"
                                        Click="PopOutTab_Click"
                                        ToolTip.Tip="{loc:Tr Tab_PopOut}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="tab" GroupName="MainTabs"
                                     IsChecked="{Binding IsConfigTab, Mode=TwoWay}"
                                     IsVisible="{Binding ConfigTab, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{loc:Tr Tab_Config}" VerticalAlignment="Center" />
                        </RadioButton>
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding CurrentTabContent}" />
            </DockPanel>

        </Grid>

    </Grid>

</UserControl>
