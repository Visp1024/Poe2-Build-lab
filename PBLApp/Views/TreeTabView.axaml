<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PBLApp.ViewModels"
             xmlns:ctrl="using:PBLApp.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="700"
             xmlns:loc="using:PBLApp.Localization"
             x:Class="PBLApp.Views.TreeTabView"
             x:DataType="vm:TreeTabViewModel">

    <UserControl.Styles>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgMantleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgMantleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource BgMantleBrush}"
                BorderBrush="{DynamicResource BgRaisedBrush}" BorderThickness="0,0,0,1"
                Padding="10,5">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Class/ascendancy selectors live in the BuildPageView header -->

                <!-- Search -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr Tree_Search}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SearchText}"
                             PlaceholderText="{loc:Tr Tree_PhNodeName}"
                             Width="180" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Stats -->
                <TextBlock Text="{Binding NodesLabel}"
                           Foreground="{DynamicResource BorderStrongBrush}" FontSize="11"
                           Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding AllocatedLabel}"
                           Foreground="{DynamicResource AttrDexBrush}" FontSize="11" FontWeight="Bold"
                           Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PointsLabel}"
                           Classes.over="{Binding IsPassivesOverBudget}"
                           FontSize="11" FontWeight="Bold"
                           Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock.Styles>
                        <!-- Style setters (not a local Foreground) so the over-budget
                             selector can override the default colour. -->
                        <Style Selector="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource AttrIntBrush}"/>
                        </Style>
                        <Style Selector="TextBlock.over">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>
                <!-- Weapon-set point pools — shown only for Weapon Master / builds using them. -->
                <TextBlock Text="{Binding WeaponSetLabel}"
                           IsVisible="{Binding HasWeaponSetPoints}"
                           Foreground="{DynamicResource StatDpsBrush}" FontSize="11" FontWeight="Bold"
                           Margin="0,0,12,0" VerticalAlignment="Center"
                           ToolTip.Tip="{loc:Tr Tree_WeaponSetTip}"/>

                <!-- Hint -->
                <TextBlock Text="{loc:Tr Tree_Hint}"
                           Foreground="{DynamicResource BgRaisedBrush}" FontSize="10"
                           VerticalAlignment="Center"/>

            </WrapPanel>
        </Border>

        <!-- Tree canvas -->
        <ctrl:TreeCanvas x:Name="TreeCanvasControl"
                         Grid.Row="1"
                         Nodes="{Binding Nodes}"
                         AllocatedIds="{Binding AllocatedIds}"
                         SearchText="{Binding SearchText}"
                         AscendancyFilter="{Binding AscendancyFilter}"
                         ClassBackgroundImage="{Binding ClassBackgroundImage}"
                         AllocNodeCommand="{Binding AllocNodeCommand}"
                         DeallocNodeCommand="{Binding DeallocNodeCommand}"
                         RadiusEmitters="{Binding RadiusEmitters}"
                         AscendancyBackgrounds="{Binding AscendancyBackgrounds}"
                         ClipToBounds="True" />

    </Grid>

</UserControl>
