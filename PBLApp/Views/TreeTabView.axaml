<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PBLApp.ViewModels"
             xmlns:ctrl="using:PBLApp.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="700"
             xmlns:loc="using:PBLApp.Localization"
             x:Class="PBLApp.Views.TreeTabView"
             x:DataType="vm:TreeTabViewModel">

    <UserControl.Styles>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgMantleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgMantleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource BgMantleBrush}"
                BorderBrush="{DynamicResource BgRaisedBrush}" BorderThickness="0,0,0,1"
                Padding="10,5">
            <Grid ColumnDefinitions="*,Auto">
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Class/ascendancy selectors live in the BuildPageView header -->

                    <!-- Search -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr Tree_Search}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SearchText}"
                                 PlaceholderText="{loc:Tr Tree_PhNodeName}"
                                 Width="180" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Stats -->
                    <TextBlock Text="{Binding NodesLabel}"
                               Foreground="{DynamicResource BorderStrongBrush}" FontSize="11"
                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AllocatedLabel}"
                               Foreground="{DynamicResource AttrDexBrush}" FontSize="11" FontWeight="Bold"
                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PointsLabel}"
                               Classes.over="{Binding IsPassivesOverBudget}"
                               FontSize="11" FontWeight="Bold"
                               Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Styles>
                            <!-- Style setters (not a local Foreground) so the over-budget
                                 selector can override the default colour. -->
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource AttrIntBrush}"/>
                            </Style>
                            <Style Selector="TextBlock.over">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    <!-- Weapon-set point pools — shown only for Weapon Master / builds using them. -->
                    <TextBlock Text="{Binding WeaponSetLabel}"
                               IsVisible="{Binding HasWeaponSetPoints}"
                               Foreground="{DynamicResource StatDpsBrush}" FontSize="11" FontWeight="Bold"
                               Margin="0,0,12,0" VerticalAlignment="Center"
                               ToolTip.Tip="{loc:Tr Tree_WeaponSetTip}"/>

                    <!-- Hint -->
                    <TextBlock Text="{loc:Tr Tree_Hint}"
                               Foreground="{DynamicResource BgRaisedBrush}" FontSize="10"
                               VerticalAlignment="Center"/>

                </WrapPanel>

                <!-- Heat-map toggle pinned to the right edge -->
                <ToggleButton Grid.Column="1" Content="{loc:Tr Tree_Heatmap}"
                              IsChecked="{Binding HeatmapEnabled}"
                              VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Row 1: canvas + collapsible Power Report side panel -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <!-- Tree canvas -->
            <ctrl:TreeCanvas x:Name="TreeCanvasControl"
                             Grid.Column="0"
                             Nodes="{Binding Nodes}"
                             AllocatedIds="{Binding AllocatedIds}"
                             SearchText="{Binding SearchText}"
                             IsBusy="{Binding IsToggleBusy}"
                             AscendancyFilter="{Binding AscendancyFilter}"
                             ClassBackgroundImage="{Binding ClassBackgroundImage}"
                             AllocNodeCommand="{Binding AllocNodeCommand}"
                             DeallocNodeCommand="{Binding DeallocNodeCommand}"
                             RadiusEmitters="{Binding RadiusEmitters}"
                             JewelRadii="{Binding JewelRadii}"
                             JewelIcons="{Binding JewelIcons}"
                             AscendancyBackgrounds="{Binding AscendancyBackgrounds}"
                             ClipToBounds="True" />

            <!-- In-tree jewel picker overlay: opens on clicking an allocated socket -->
            <Grid Grid.Column="0" IsVisible="{Binding IsJewelPickerOpen}">
                <!-- transparent dismiss layer (click outside closes) -->
                <Border Background="#01000000" PointerPressed="JewelPickerDismiss_PointerPressed"/>
                <Canvas>
                    <Border Canvas.Left="{Binding JewelPickerX}" Canvas.Top="{Binding JewelPickerY}"
                            Background="{DynamicResource BgMantleBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="4"
                            MinWidth="230" MaxWidth="300" MaxHeight="380">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding JewelPickerTitle}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Margin="6,4,6,6"
                                       IsVisible="{Binding JewelPickerTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="JewelPickerList"
                                         ItemsSource="{Binding JewelPickerOptions}"
                                         Background="Transparent"
                                         SelectionChanged="JewelPicker_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:JewelPickerOptionVm">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Height="26">
                                                <Image Grid.Column="0" Width="22" Height="22"
                                                       Margin="0,0,8,0"
                                                       IsVisible="{Binding HasIcon}"
                                                       Source="{Binding IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           Foreground="{Binding NameColor}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding StatusText}"
                                                           IsVisible="{Binding HasStatus}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="10" FontStyle="Italic"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Canvas>
            </Grid>

            <!-- Power Report side panel -->
            <Border Grid.Column="1"
                    Width="{Binding PowerPanelWidth}" MinWidth="260" MaxWidth="680"
                    IsVisible="{Binding HeatmapEnabled}"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Thumb DockPanel.Dock="Left" Width="5" Cursor="SizeWestEast"
                           Background="{DynamicResource BorderSubtleBrush}"
                           DragDelta="PowerPanelThumb_DragDelta"/>
                <DockPanel Margin="10">

                    <!-- Header -->
                    <StackPanel DockPanel.Dock="Top" Spacing="8">
                        <TextBlock Text="{loc:Tr Tree_PowerReport}" FontWeight="SemiBold" FontSize="15"/>
                        <!-- Stat selector gets its own full-width row: sharing a row with
                             the localized Generate button squeezed it to ~110px at the
                             default panel width (same fix as TraderWindow header rows). -->
                        <ComboBox MinWidth="180" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding PowerStatOptions}"
                                  SelectedItem="{Binding SelectedPowerStat}"/>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="{loc:Tr Tree_Power_Generate}"
                                Command="{Binding GeneratePowerCommand}"
                                IsVisible="{Binding !IsPowerBuilding}"/>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="{loc:Tr Tree_Power_Cancel}"
                                Command="{Binding CancelPowerCommand}"
                                IsVisible="{Binding IsPowerBuilding}"/>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:Tr Tree_Power_WorkerCount}"
                                       VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
                            <ComboBox Grid.Column="1" Margin="6,0" MinWidth="90" FontSize="12"
                                      SelectedIndex="{Binding WorkerCountIndex}">
                                <ComboBoxItem Content="{loc:Tr Tree_Power_WorkerAuto}"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="{loc:Tr Tree_Power_WorkerOff}"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="{Binding PowerWorkersStatus}"
                                       VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPowerBuilding}">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding PowerBuildProgress}" Width="180"/>
                            <TextBlock Text="{loc:Tr Tree_Power_Building}" Opacity="0.7" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border IsVisible="{Binding IsPowerStale}" CornerRadius="6" Padding="8,5"
                                Background="{DynamicResource BgRaisedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding PowerStaleLabel}" VerticalAlignment="Center" FontSize="12"/>
                                <Button Content="{loc:Tr Tree_Power_Refresh}" Padding="8,3"
                                        Command="{Binding RefreshPowerCommand}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding PowerError}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                                   IsVisible="{Binding PowerError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   TextWrapping="Wrap"/>

                        <!-- Sort + filter -->
                        <Grid ColumnDefinitions="Auto,*">
                            <ComboBox Grid.Column="0" MinWidth="130" FontSize="12"
                                      SelectedIndex="{Binding PowerSortIndex}">
                                <ComboBoxItem Content="{loc:Tr Tree_Power_SortPower}"/>
                                <ComboBoxItem Content="{loc:Tr Tree_Power_SortPerPoint}"/>
                            </ComboBox>
                            <TextBox Grid.Column="1" Margin="6,0,0,0" FontSize="12" MinWidth="110"
                                     PlaceholderText="{loc:Tr Tree_Power_Filter}"
                                     Text="{Binding PowerFilter, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding PowerEmptyLabel}"
                               IsVisible="{Binding !HasPowerReport}" Opacity="0.6" Margin="0,10"/>

                    <!-- Cards -->
                    <ListBox x:Name="PowerReportList" ItemsSource="{Binding PowerReport}"
                             Background="Transparent" DoubleTapped="PowerReportList_DoubleTapped"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NodePowerRowViewModel">
                                <Border Background="{DynamicResource BgMantleBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" Margin="0,2">
                                    <StackPanel Spacing="2">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1"
                                                    Background="{DynamicResource BgRaisedBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding TypeBadge}" FontSize="10" Opacity="0.8"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StepsStr}"
                                                       FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding PowerStr}" Foreground="{Binding PowerColor}"
                                                           FontSize="13"/>
                                                <TextBlock Text="{Binding PerPointStr}" FontSize="11" Opacity="0.75"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                </DockPanel>
            </Border>

        </Grid>

    </Grid>

</UserControl>
