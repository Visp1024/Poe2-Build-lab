<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PBLApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             xmlns:loc="using:PBLApp.Localization"
             xmlns:ctl="using:PBLApp.Controls"
             x:Class="PBLApp.Views.ItemsTabView"
             x:DataType="vm:ItemsTabViewModel">

    <UserControl.Styles>

        <!-- Slot cell (figure layout) — Border, not Button. The SukiTheme Button
             template's ContentPresenter shrink-wraps content and ignores Stretch on
             the inner Grid, so a 50×100 Flask cell ends up with its content blob
             jammed against one edge. Border has no template; child layout is honest.
             (avalonia-suki-gotchas → "SukiTheme Button is hostile to custom layouts")

             Click/selection is handled by a single tunnel PointerPressed handler in
             code-behind that walks Tag="slot:*" up the visual tree. The visual states
             below are driven by pseudo-classes (:pointerover) and the
             Classes.selected="…" binding on each cell. -->
        <!-- Slots live on a Canvas now; size is set per-slot via Width/Height and
             positioned via Canvas.Left/Top so each item keeps its game-natural
             aspect ratio with breathing room between groups (no rigid grid). -->
        <Style Selector="Border.slot-cell">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BgRaisedBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="DragDrop.AllowDrop" Value="True"/>
        </Style>
        <Style Selector="Border.slot-cell:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}"/>
        </Style>
        <Style Selector="Border.slot-cell.selected">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
        <Style Selector="Button.pool-btn">
            <Setter Property="DragDrop.AllowDrop" Value="True"/>
        </Style>

        <!-- Weapon swap button (I / II) -->
        <Style Selector="Button.swap-btn">
            <Setter Property="Background" Value="{DynamicResource BgMantleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.swap-btn.active">
            <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AttrIntBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.swap-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Item icon inside slot — fills the cell when an icon is available; the
             text fallback (slot-fallback below) hides itself in that case. -->
        <Style Selector="Image.slot-icon">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- Text fallback when no icon is available (light build, or icon missing). -->
        <Style Selector="StackPanel.slot-fallback">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Spacing" Value="1"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style Selector="TextBlock.slot-fallback-label">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="TextBlock.slot-fallback-name">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="LineHeight" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="92"/>
        </Style>
        <!-- Compact variant for small 1x1 / narrow slots (Ring, Amulet, Charm, Belt) -->
        <Style Selector="TextBlock.slot-fallback-name-compact">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="LineHeight" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Item icon inside the pool-row thumbnail -->
        <Style Selector="Image.pool-icon">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Pool list item row -->
        <Style Selector="Button.pool-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Button.pool-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.pool-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
        </Style>
        <Style Selector="Button.pool-btn.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}"/>
        </Style>
        <Style Selector="Button.pool-btn.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AttrIntBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- Section header label -->
        <Style Selector="TextBlock.section-header">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <!-- Danger/delete button -->
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{DynamicResource AttrStrBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AttrStrBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Icon-style small button -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
        </Style>

        <!-- Import textarea -->
        <Style Selector="TextBox.import-box">
            <Setter Property="Background" Value="{DynamicResource BgBaseBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ModImplicitBrush}"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- Plain-text hover tooltips on slot/pool cells. The default Avalonia ToolTip
             renders compact white-on-black with a tight box; for multi-line item
             tooltips that's hard to read. Restyle: dark mantle bg, gold-tinted border,
             larger body font, generous line spacing — first line is the item name and
             gets a bigger title-style size via a TextBlock template later. -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource BgMantleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brand400Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <!-- The inner ContentPresenter wraps the text — give it more breathing room
             between lines (Avalonia's default LineHeight is tight). -->
        <Style Selector="ToolTip /template/ ContentPresenter">
            <Setter Property="TextBlock.LineHeight" Value="20" />
            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
        </Style>

    </UserControl.Styles>

    <!-- Root: left panel | splitter | right panel
         Default 50/50 split (resizable via the GridSplitter). The slot canvas is
         a fixed 540×530 pixel layout, so we set MinWidth on the left container to
         that width — shrinking below would clip Canvas-positioned slots. -->
    <Grid ColumnDefinitions="*,5,*">

        <!-- ── Left panel ──────────────────────────────────────────────────── -->
        <Border Grid.Column="0"
                MinWidth="540"
                Background="{DynamicResource BgMantleBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,1,0">

            <DockPanel>

                <!-- ── Import panel (collapsible, DockPanel.Top) ─────────── -->
                <Border DockPanel.Dock="Top"
                        IsVisible="{Binding IsImportPanelOpen}"
                        Background="{DynamicResource BgMantleBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1"
                        Padding="8,8,8,10">
                    <StackPanel Spacing="6">

                        <!-- Header row -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Tr ItemImport_Header}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Command="{Binding CloseImportPanelCommand}"
                                    Classes="icon-btn"
                                    Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                        </Grid>

                        <!-- Paste hint -->
                        <TextBlock Text="{loc:Tr ItemImport_Hint}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/>

                        <!-- Text area -->
                        <TextBox Text="{Binding ImportItemText}"
                                 Classes="import-box"
                                 AcceptsReturn="True"
                                 AcceptsTab="False"
                                 Height="160"
                                 Watermark="Rarity: Rare&#10;Item Name&#10;Base Type&#10;--------&#10;+80 to maximum Life&#10;..."/>

                        <!-- Error -->
                        <TextBlock Text="{Binding ImportError}"
                                   IsVisible="{Binding ImportError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{DynamicResource AttrStrBrush}" FontSize="10" TextWrapping="Wrap"/>

                        <!-- Add button -->
                        <Button Content="{loc:Tr ItemImport_AddBtn}"
                                Command="{Binding ConfirmImportCommand}"
                                Background="{DynamicResource BgRaisedBrush}"
                                BorderBrush="{DynamicResource AttrIntBrush}" BorderThickness="1"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                FontSize="11" Padding="0,6"/>

                    </StackPanel>
                </Border>

                <!-- ── Slots + Pool scroll area ──────────────────────────── -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12,8,12" Spacing="0">

                        <!-- EQUIPPED ITEMS label -->
                        <TextBlock Text="{loc:Tr Item_EquippedHeader}" Classes="section-header" Margin="0,0,0,6"/>

                        <!-- ═══════════════════════════════════════════════════════════
                             Character figure — 9 cols × 9 rows of 60dip cells
                             (total 540×540). Larger cells give accessory slots
                             (rings, amulet, charms) room to breathe.

                             Layout:
                                  0  1 |  2 | 3  4 | 5 | 6  7  8
                                0          [Amul]                          ← amulet on top
                                1 [W1 W1]    [Hl Hl]    [W2 W2]
                                2 [W1 W1]    [Hl Hl]    [W2 W2]
                                3 [W1 W1][R1][Bd Bd][R2][W2 W2]            ← rings flank body (1×2)
                                4 [W1 W1][R1][Bd Bd][R2][W2 W2]
                                5 [W1 W1]    [Bd Bd]    [W2 W2]
                                6                [Be Be]                   ← belt under body (2×1)
                                7 [Gl Gl][F1][C1][C2][C3][F2][Bo Bo]       ← charms between flasks
                                8 [Gl Gl][F1][C1][C2][C3][F2][Bo Bo]
                             ═══════════════════════════════════════════════════════════ -->
                        <StackPanel HorizontalAlignment="Center" Spacing="6">

                            <!-- Weapon-set toggle — single compact row centred over the figure. -->
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                                        Margin="0,0,0,2">
                                <Button Classes="swap-btn"
                                        Classes.active="{Binding IsWeaponSet1Active}"
                                        Command="{Binding SelectWeaponSet1Command}"
                                        Content="I"/>
                                <Button Classes="swap-btn"
                                        Classes.active="{Binding IsWeaponSet2Active}"
                                        Command="{Binding SelectWeaponSet2Command}"
                                        Content="II"/>
                            </StackPanel>

                            <Canvas Width="540" Height="530">

                                <!-- ── Helmet (cols 3-4, rows 0-1) — 2×2 ────────────── -->
                                <Border Canvas.Left="197" Canvas.Top="15" Width="145" Height="115" Classes="slot-cell"
                                        Classes.selected="{Binding Helmet.IsSelected}"
                                        BorderBrush="{Binding Helmet.NameColor}"
                                        Tag="slot:Helmet" ctl:StyledHoverTooltip.Source="{Binding Helmet.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Helmet.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Helmet.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Helmet.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Helmet}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Helmet.LeftDisplayName}"
                                                       Foreground="{Binding Helmet.NameColor}"
                                                       Classes="slot-fallback-name"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Amulet (col 5, row 1) — 1×1 ──────────────────── -->
                                <Border Canvas.Left="348" Canvas.Top="60" Width="70" Height="70" Classes="slot-cell"
                                        Classes.selected="{Binding Amulet.IsSelected}"
                                        BorderBrush="{Binding Amulet.NameColor}"
                                        Tag="slot:Amulet" ctl:StyledHoverTooltip.Source="{Binding Amulet.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Amulet.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Amulet.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Amulet.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Amulet}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Amulet.LeftDisplayName}"
                                                       Foreground="{Binding Amulet.NameColor}"
                                                       Classes="slot-fallback-name-compact"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Weapon 1 (cols 0-1, rows 2-5) — 2×4 ─────────── -->
                                <Border Canvas.Left="10" Canvas.Top="10" Width="102" Height="221" IsVisible="{Binding IsWeaponSet1Active}"
                                        Classes="slot-cell"
                                        Classes.selected="{Binding Weapon1.IsSelected}"
                                        BorderBrush="{Binding Weapon1.NameColor}"
                                        Tag="slot:Weapon 1" ctl:StyledHoverTooltip.Source="{Binding Weapon1.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Weapon1.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Weapon1.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Weapon1.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Weapon1}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Weapon1.LeftDisplayName}"
                                                       Foreground="{Binding Weapon1.NameColor}"
                                                       Classes="slot-fallback-name"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Weapon 1 Swap — overlays Weapon1, toggled via IsVisible ── -->
                                <Border Canvas.Left="10" Canvas.Top="10" Width="102" Height="221" IsVisible="{Binding IsWeaponSet2Active}"
                                        Classes="slot-cell"
                                        Classes.selected="{Binding Weapon1Swap.IsSelected}"
                                        BorderBrush="{Binding Weapon1Swap.NameColor}"
                                        Tag="slot:Weapon 1 Swap" ctl:StyledHoverTooltip.Source="{Binding Weapon1Swap.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Weapon1Swap.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Weapon1Swap.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Weapon1Swap.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Weapon1}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Weapon1Swap.LeftDisplayName}"
                                                       Foreground="{Binding Weapon1Swap.NameColor}"
                                                       Classes="slot-fallback-name"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Body Armour (cols 3-4, rows 3-5) — 2×3 ──────── -->
                                <Border Canvas.Left="197" Canvas.Top="140" Width="145" Height="175" Classes="slot-cell"
                                        Classes.selected="{Binding BodyArmour.IsSelected}"
                                        BorderBrush="{Binding BodyArmour.NameColor}"
                                        Tag="slot:Body Armour" ctl:StyledHoverTooltip.Source="{Binding BodyArmour.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding BodyArmour.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding BodyArmour.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !BodyArmour.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_BodyArmour}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding BodyArmour.LeftDisplayName}"
                                                       Foreground="{Binding BodyArmour.NameColor}"
                                                       Classes="slot-fallback-name"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Ring 1 (col 5, row 3) — 1×1 ──────────────────── -->
                                <Border Canvas.Left="122" Canvas.Top="147" Width="70" Height="70" Classes="slot-cell"
                                        Classes.selected="{Binding Ring1.IsSelected}"
                                        BorderBrush="{Binding Ring1.NameColor}"
                                        Tag="slot:Ring 1" ctl:StyledHoverTooltip.Source="{Binding Ring1.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Ring1.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Ring1.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Ring1.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Ring1}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Ring1.LeftDisplayName}"
                                                       Foreground="{Binding Ring1.NameColor}"
                                                       Classes="slot-fallback-name-compact"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Ring 2 (col 5, row 4) — 1×1 ──────────────────── -->
                                <Border Canvas.Left="348" Canvas.Top="147" Width="70" Height="70" Classes="slot-cell"
                                        Classes.selected="{Binding Ring2.IsSelected}"
                                        BorderBrush="{Binding Ring2.NameColor}"
                                        Tag="slot:Ring 2" ctl:StyledHoverTooltip.Source="{Binding Ring2.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Ring2.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Ring2.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Ring2.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Ring2}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Ring2.LeftDisplayName}"
                                                       Foreground="{Binding Ring2.NameColor}"
                                                       Classes="slot-fallback-name-compact"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Weapon 2 (cols 7-8, rows 2-5) — 2×4 ─────────── -->
                                <Border Canvas.Left="428" Canvas.Top="10" Width="102" Height="221" IsVisible="{Binding IsWeaponSet1Active}"
                                        Classes="slot-cell"
                                        Classes.selected="{Binding Weapon2.IsSelected}"
                                        BorderBrush="{Binding Weapon2.NameColor}"
                                        Tag="slot:Weapon 2" ctl:StyledHoverTooltip.Source="{Binding Weapon2.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Weapon2.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Weapon2.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Weapon2.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Weapon2}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Weapon2.LeftDisplayName}"
                                                       Foreground="{Binding Weapon2.NameColor}"
                                                       Classes="slot-fallback-name"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Weapon 2 Swap — overlays Weapon2, toggled via IsVisible ── -->
                                <Border Canvas.Left="428" Canvas.Top="10" Width="102" Height="221" IsVisible="{Binding IsWeaponSet2Active}"
                                        Classes="slot-cell"
                                        Classes.selected="{Binding Weapon2Swap.IsSelected}"
                                        BorderBrush="{Binding Weapon2Swap.NameColor}"
                                        Tag="slot:Weapon 2 Swap" ctl:StyledHoverTooltip.Source="{Binding Weapon2Swap.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Weapon2Swap.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Weapon2Swap.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Weapon2Swap.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Weapon2}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Weapon2Swap.LeftDisplayName}"
                                                       Foreground="{Binding Weapon2Swap.NameColor}"
                                                       Classes="slot-fallback-name"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Belt (cols 3-4, row 6) — 2×1 ─────────────────── -->
                                <Border Canvas.Left="197" Canvas.Top="325" Width="145" Height="60" Classes="slot-cell"
                                        Classes.selected="{Binding Belt.IsSelected}"
                                        BorderBrush="{Binding Belt.NameColor}"
                                        Tag="slot:Belt" ctl:StyledHoverTooltip.Source="{Binding Belt.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Belt.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Belt.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Belt.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Belt}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Belt.LeftDisplayName, FallbackValue=''}"
                                                       Foreground="{Binding Belt.NameColor}"
                                                       Classes="slot-fallback-name-compact"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Gloves (cols 0-1, rows 7-8) — 2×2 ────────────── -->
                                <Border Canvas.Left="60" Canvas.Top="259" Width="132" Height="126" Classes="slot-cell"
                                        Classes.selected="{Binding Gloves.IsSelected}"
                                        BorderBrush="{Binding Gloves.NameColor}"
                                        Tag="slot:Gloves" ctl:StyledHoverTooltip.Source="{Binding Gloves.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Gloves.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Gloves.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Gloves.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Gloves}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Gloves.LeftDisplayName}"
                                                       Foreground="{Binding Gloves.NameColor}"
                                                       Classes="slot-fallback-name"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Boots (cols 7-8, rows 7-8) — 2×2 ─────────────── -->
                                <Border Canvas.Left="348" Canvas.Top="259" Width="132" Height="126" Classes="slot-cell"
                                        Classes.selected="{Binding Boots.IsSelected}"
                                        BorderBrush="{Binding Boots.NameColor}"
                                        Tag="slot:Boots" ctl:StyledHoverTooltip.Source="{Binding Boots.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Boots.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Boots.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Boots.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Boots}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Boots.LeftDisplayName}"
                                                       Foreground="{Binding Boots.NameColor}"
                                                       Classes="slot-fallback-name"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Charms (cols 3-5, row 7) — three 1×1 cells ──── -->
                                <Border Canvas.Left="190" Canvas.Top="405" Width="50" Height="100" Classes="slot-cell"
                                        Classes.selected="{Binding Charm1.IsSelected}"
                                        BorderBrush="{Binding Charm1.NameColor}"
                                        Tag="slot:Charm 1" ctl:StyledHoverTooltip.Source="{Binding Charm1.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Charm1.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Charm1.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Charm1.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Charm1}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Charm1.LeftDisplayName}"
                                                       Foreground="{Binding Charm1.NameColor}"
                                                       Classes="slot-fallback-name-compact"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Canvas.Left="245" Canvas.Top="405" Width="50" Height="100" Classes="slot-cell"
                                        Classes.selected="{Binding Charm2.IsSelected}"
                                        BorderBrush="{Binding Charm2.NameColor}"
                                        Tag="slot:Charm 2" ctl:StyledHoverTooltip.Source="{Binding Charm2.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Charm2.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Charm2.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Charm2.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Charm2}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Charm2.LeftDisplayName}"
                                                       Foreground="{Binding Charm2.NameColor}"
                                                       Classes="slot-fallback-name-compact"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Canvas.Left="300" Canvas.Top="405" Width="50" Height="100" Classes="slot-cell"
                                        Classes.selected="{Binding Charm3.IsSelected}"
                                        BorderBrush="{Binding Charm3.NameColor}"
                                        Tag="slot:Charm 3" ctl:StyledHoverTooltip.Source="{Binding Charm3.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Charm3.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Charm3.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Charm3.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Charm3}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Charm3.LeftDisplayName}"
                                                       Foreground="{Binding Charm3.NameColor}"
                                                       Classes="slot-fallback-name-compact"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Flask 1 (col 3, rows 9-10) — 1×2 ─────────────── -->
                                <Border Canvas.Left="95" Canvas.Top="395" Width="60" Height="120" Classes="slot-cell"
                                        Classes.selected="{Binding Flask1.IsSelected}"
                                        BorderBrush="{Binding Flask1.NameColor}"
                                        Tag="slot:Flask 1" ctl:StyledHoverTooltip.Source="{Binding Flask1.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Flask1.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Flask1.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Flask1.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Flask1}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Flask1.LeftDisplayName}"
                                                       Foreground="{Binding Flask1.NameColor}"
                                                       Classes="slot-fallback-name"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Flask 2 (col 4, rows 9-10) — 1×2 ─────────────── -->
                                <Border Canvas.Left="390" Canvas.Top="395" Width="60" Height="120" Classes="slot-cell"
                                        Classes.selected="{Binding Flask2.IsSelected}"
                                        BorderBrush="{Binding Flask2.NameColor}"
                                        Tag="slot:Flask 2" ctl:StyledHoverTooltip.Source="{Binding Flask2.HoverTooltip}" ToolTip.ShowDelay="400" ToolTip.Placement="Pointer">
                                    <Grid>
                                        <Image Classes="slot-icon"
                                               Source="{Binding Flask2.IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                               IsVisible="{Binding Flask2.HasIcon}"/>
                                        <StackPanel Classes="slot-fallback"
                                                    IsVisible="{Binding !Flask2.HasIcon}">
                                            <TextBlock Text="{loc:Tr Slot_Flask2}" Classes="slot-fallback-label"/>
                                            <TextBlock Text="{Binding Flask2.LeftDisplayName}"
                                                       Foreground="{Binding Flask2.NameColor}"
                                                       Classes="slot-fallback-name"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </Canvas>
                        </StackPanel>

                        <!-- ── BASE JEWELS strip (jewel sockets on tree) ────────── -->
                        <StackPanel IsVisible="{Binding JewelSlots.Count}" Margin="0,4,0,0" Spacing="4">
                            <TextBlock Text="{loc:Tr Item_BaseJewelsHeader}" Classes="section-header"/>
                            <ItemsControl ItemsSource="{Binding JewelSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:JewelSocketSlotViewModel">
                                        <Border Width="67" Height="67" Margin="2"
                                                Classes="slot-cell"
                                                Classes.selected="{Binding IsSelected}"
                                                BorderBrush="{Binding NameColor}"
                                                Tag="{Binding SlotName, StringFormat='slot:{0}'}">
                                            <Grid>
                                                <Image Classes="slot-icon"
                                                       Source="{Binding IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                                       IsVisible="{Binding HasIcon}"/>
                                                <TextBlock Text="{Binding LeftDisplayName}"
                                                           IsVisible="{Binding !HasIcon}"
                                                           Foreground="{Binding NameColor}"
                                                           FontSize="9" TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextAlignment="Center"
                                                           MaxHeight="50"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ── EXTRA SLOTS (Ring3 / Arm1-2 / Leg1-2) — only if any non-empty ── -->
                        <StackPanel IsVisible="{Binding HasExtraSlots}" Margin="0,8,0,0" Spacing="4">
                            <TextBlock Text="{loc:Tr Item_ExtraSlotsHeader}" Classes="section-header"/>
                            <WrapPanel Orientation="Horizontal">
                                <Border IsVisible="{Binding !Ring3.IsEmpty}"
                                        Width="58" Height="40" Margin="2"
                                        Classes="slot-cell"
                                        Classes.selected="{Binding Ring3.IsSelected}"
                                        BorderBrush="{Binding Ring3.NameColor}"
                                        Tag="{Binding Ring3.SlotName, StringFormat='slot:{0}'}">
                                    <TextBlock Text="{Binding Ring3.LeftDisplayName}"
                                               Foreground="{Binding Ring3.NameColor}"
                                               FontSize="9" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border IsVisible="{Binding !Arm1.IsEmpty}"
                                        Width="58" Height="40" Margin="2"
                                        Classes="slot-cell"
                                        Classes.selected="{Binding Arm1.IsSelected}"
                                        BorderBrush="{Binding Arm1.NameColor}"
                                        Tag="{Binding Arm1.SlotName, StringFormat='slot:{0}'}">
                                    <TextBlock Text="{Binding Arm1.LeftDisplayName}"
                                               Foreground="{Binding Arm1.NameColor}"
                                               FontSize="9" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border IsVisible="{Binding !Arm2.IsEmpty}"
                                        Width="58" Height="40" Margin="2"
                                        Classes="slot-cell"
                                        Classes.selected="{Binding Arm2.IsSelected}"
                                        BorderBrush="{Binding Arm2.NameColor}"
                                        Tag="{Binding Arm2.SlotName, StringFormat='slot:{0}'}">
                                    <TextBlock Text="{Binding Arm2.LeftDisplayName}"
                                               Foreground="{Binding Arm2.NameColor}"
                                               FontSize="9" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border IsVisible="{Binding !Leg1.IsEmpty}"
                                        Width="58" Height="40" Margin="2"
                                        Classes="slot-cell"
                                        Classes.selected="{Binding Leg1.IsSelected}"
                                        BorderBrush="{Binding Leg1.NameColor}"
                                        Tag="{Binding Leg1.SlotName, StringFormat='slot:{0}'}">
                                    <TextBlock Text="{Binding Leg1.LeftDisplayName}"
                                               Foreground="{Binding Leg1.NameColor}"
                                               FontSize="9" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border IsVisible="{Binding !Leg2.IsEmpty}"
                                        Width="58" Height="40" Margin="2"
                                        Classes="slot-cell"
                                        Classes.selected="{Binding Leg2.IsSelected}"
                                        BorderBrush="{Binding Leg2.NameColor}"
                                        Tag="{Binding Leg2.SlotName, StringFormat='slot:{0}'}">
                                    <TextBlock Text="{Binding Leg2.LeftDisplayName}"
                                               Foreground="{Binding Leg2.NameColor}"
                                               FontSize="9" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>


                        <!-- ── ITEM POOL section ─────────────────────────── -->
                        <Border Margin="0,12,0,0" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel Spacing="4">

                                <!-- Pool header -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Tr Item_PoolHeader}"
                                               Classes="section-header"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Content="{loc:Tr Item_PoolCreate}"
                                                Command="{Binding OpenNewItemEditorCommand}"
                                                Classes="icon-btn"
                                                Foreground="{DynamicResource AttrIntBrush}"
                                                BorderBrush="{DynamicResource AttrIntBrush}"
                                                FontSize="10"
                                                Padding="6,2"/>
                                        <Button Content="{loc:Tr Item_PoolImport}"
                                                Command="{Binding OpenImportPanelCommand}"
                                                Classes="icon-btn"
                                                Foreground="{DynamicResource AttrDexBrush}"
                                                BorderBrush="{DynamicResource AttrDexBrush}"
                                                FontSize="10"
                                                Padding="6,2"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Search box -->
                                <TextBox Text="{Binding PoolSearchText}"
                                         Watermark="{loc:Tr Item_PoolSearch}"
                                         Background="{DynamicResource BgBaseBrush}"
                                         BorderBrush="{DynamicResource BorderStrongBrush}"
                                         Foreground="{DynamicResource ModImplicitBrush}"
                                         FontSize="11"
                                         Padding="6,4"
                                         Margin="0,2,0,0"/>

                                <!-- Pool list (also serves as a drop target — drag a slot's item here to unequip) -->
                                <Border Background="{DynamicResource BgBaseBrush}"
                                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                        MinHeight="60" MaxHeight="380"
                                        Tag="unequip"
                                        DragDrop.AllowDrop="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FilteredPool}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:ItemPoolEntryViewModel">
                                                    <Button Classes="pool-btn"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Tag="{Binding ItemId, StringFormat='pool:{0}'}"
                                                            ctl:StyledHoverTooltip.Source="{Binding HoverTooltip}"
                                                            ToolTip.ShowDelay="400"
                                                            ToolTip.Placement="Pointer">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                                                            <!-- Icon thumbnail -->
                                                            <Image Grid.Column="0"
                                                                   Classes="pool-icon"
                                                                   Source="{Binding IconPath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                                                   IsVisible="{Binding HasIcon}"
                                                                   Margin="0,0,8,0"/>

                                                            <!-- Item name + base (rarity-coloured for legibility) -->
                                                            <StackPanel Grid.Column="1" Spacing="1"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PoolTopName}"
                                                                           IsVisible="{Binding HasTopName}"
                                                                           Foreground="{Binding NameColor}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding PoolBaseName}"
                                                                           Foreground="{Binding NameColor}"
                                                                           FontSize="12"
                                                                           Opacity="0.85"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <!-- Equipped slot badge -->
                                                            <Border Grid.Column="2"
                                                                    IsVisible="{Binding IsEquipped}"
                                                                    Background="{DynamicResource BgSurfaceBrush}"
                                                                    BorderBrush="{DynamicResource AttrIntBrush}" BorderThickness="1"
                                                                    CornerRadius="2"
                                                                    Padding="6,2"
                                                                    Margin="6,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding EquippedSlot}"
                                                                           Foreground="{DynamicResource AttrIntBrush}"
                                                                           FontSize="10" FontWeight="SemiBold"/>
                                                            </Border>

                                                            <!-- iLvl -->
                                                            <TextBlock Grid.Column="2"
                                                                       IsVisible="{Binding !IsEquipped}"
                                                                       Text="{Binding ItemLevel, StringFormat='iLvl {0}'}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       FontSize="10"
                                                                       Margin="6,0"
                                                                       VerticalAlignment="Center"/>

                                                            <!-- Delete button -->
                                                            <Button Grid.Column="3"
                                                                    Content="✕"
                                                                    Command="{Binding DeleteCommand}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                                    FontSize="12"
                                                                    Padding="6,0"
                                                                    VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Empty state -->
                                <TextBlock Text="{loc:Tr Item_PoolEmpty}"
                                           IsVisible="{Binding !HasSelectedPoolItem}"
                                           Foreground="{DynamicResource BorderStrongBrush}" FontSize="10"
                                           TextAlignment="Center" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- Splitter between left and right panes -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      ResizeDirection="Columns"
                      Background="{DynamicResource BorderSubtleBrush}"
                      HorizontalAlignment="Stretch"
                      ShowsPreview="False" />

        <!-- ── Right panel ─────────────────────────────────────────────────── -->
        <Panel Grid.Column="2">

            <!-- ── (A) Nothing selected ──────────────────────────────────── -->
            <StackPanel IsVisible="{Binding IsRightPaneEmpty}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <TextBlock Text="{loc:Tr Item_PlaceholderEdit}"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                           HorizontalAlignment="Center"/>
                <Button Content="{loc:Tr Item_CreateNew}"
                        Command="{Binding OpenNewItemEditorCommand}"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource AttrDexBrush}" BorderThickness="1"
                        Foreground="{DynamicResource AttrDexBrush}"
                        FontSize="12" Padding="16,7"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ── (B0) Styled display tooltip + Edit button ─────────────────── -->
            <DockPanel IsVisible="{Binding IsTooltipMode}" LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource BgMantleBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Edit"
                                Command="{Binding EditCurrentItemCommand}"
                                Background="{DynamicResource BgSurfaceBrush}"
                                BorderBrush="{DynamicResource Brand400Brush}" BorderThickness="1"
                                Foreground="{DynamicResource Brand400Brush}"
                                FontSize="12" Padding="14,4"/>
                    </StackPanel>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="14">
                    <ContentControl Content="{Binding ItemTooltip}"/>
                </ScrollViewer>
            </DockPanel>

            <!-- ── (B) Editor with optional equip strip ─────────────────────── -->
            <DockPanel IsVisible="{Binding IsEditorOpen}" LastChildFill="True">

                <!-- Equip strip — pool items only -->
                <Border DockPanel.Dock="Top"
                        IsVisible="{Binding IsEquipStripVisible}"
                        Background="{DynamicResource BgMantleBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <Grid ColumnDefinitions="Auto,*,8,Auto,8,Auto,8,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding PoolItemName}"
                                   Foreground="{Binding PoolItemNameColor}"
                                   FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding CompatibleSlots}"
                                  SelectedItem="{Binding SelectedEquipSlot}"
                                  Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                  HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="3"
                                Content="{loc:Tr Item_Equip}"
                                Command="{Binding EquipPoolItemCommand}"
                                Background="{DynamicResource BgRaisedBrush}"
                                BorderBrush="{DynamicResource AttrDexBrush}" BorderThickness="1"
                                Foreground="{DynamicResource AttrDexBrush}" FontSize="12" Padding="10,4"/>
                        <Button Grid.Column="5"
                                Content="{loc:Tr Item_Unequip}"
                                IsVisible="{Binding PoolItemIsEquipped}"
                                Command="{Binding UnequipPoolItemCommand}"
                                Classes="danger" FontSize="12"/>
                        <Border Grid.Column="7"
                                IsVisible="{Binding PoolItemIsEquipped}"
                                Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource AttrIntBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PoolItemEquippedSlot, StringFormat='✔ {0}'}"
                                       Foreground="{DynamicResource AttrIntBrush}" FontSize="10"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Inline editor -->
                <ContentControl Content="{Binding ItemEditor}"/>

            </DockPanel>

        </Panel>

    </Grid>

</UserControl>
