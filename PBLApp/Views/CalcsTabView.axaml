<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PBLApp.ViewModels"
             xmlns:engine="using:PBLEngine"
             xmlns:core="using:PBLApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             xmlns:loc="using:PBLApp.Localization"
             x:Class="PBLApp.Views.CalcsTabView"
             x:DataType="vm:CalcsTabViewModel">

    <UserControl.Styles>
        <Style Selector="Border.statrow">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.statrow:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgRaisedBrush}" />
        </Style>
        <Style Selector="Border.statrow.selected">
            <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}" />
        </Style>
        <Style Selector="Border.infobox">
            <Setter Property="Background" Value="{DynamicResource BgMantleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="TextBlock.boxheader">
            <Setter Property="Foreground" Value="{DynamicResource AttrIntBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.statlabel">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.statvalue">
            <Setter Property="Foreground" Value="{DynamicResource AttrDexBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*">

        <!-- Main split: stat tree | details panel.
             Skill selector moved to BuildPageView (unified top selector). -->
        <Grid Name="SplitGrid" Grid.Row="0" ColumnDefinitions="280,4,*">

            <!-- Left: stat tree -->
            <ScrollViewer Grid.Column="0" Padding="0,4,0,4">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatSectionViewModel">
                            <StackPanel Margin="0,0,0,4" IsVisible="{Binding IsVisible}">
                                <Border Background="{DynamicResource BgRaisedBrush}" Padding="8,3" Margin="0,0,0,1">
                                    <TextBlock Text="{Binding Label}"
                                               FontWeight="Bold" FontSize="11"
                                               Foreground="{DynamicResource AttrIntBrush}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatRowViewModel">
                                            <Border Classes="statrow"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Padding="8,2" Cursor="Hand">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value}"
                                                               Foreground="{DynamicResource AttrDexBrush}" FontSize="11"
                                                               FontFamily="Cascadia Code,Consolas,monospace"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          ResizeDirection="Columns"
                          Background="{DynamicResource BorderStrongBrush}" />

            <!-- Right: skill details + breakdown -->
            <ScrollViewer Grid.Column="2" Padding="8,4,4,8">
                <StackPanel Spacing="6">

                    <!-- Skill Hit Damage table -->
                    <Border Classes="infobox"
                            IsVisible="{Binding HasDamageData}">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{loc:Tr Calc_HitDamage}" Classes="boxheader" Margin="0" />
                                <TextBlock Text="—" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"
                                           IsVisible="{Binding !HasDamageData}" />
                                <TextBlock Text="{Binding AvgDamageLabel}"
                                           Foreground="{DynamicResource AttrDexBrush}" FontSize="11"
                                           FontFamily="Cascadia Code,Consolas,monospace"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Calc_AvgDamage}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Table header -->
                            <Grid ColumnDefinitions="90,*,*" Margin="0,2,0,0">
                                <TextBlock Grid.Column="0" Text="{loc:Tr Calc_ColType}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{loc:Tr Calc_ColMin}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{loc:Tr Calc_ColMax}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BorderStrongBrush}" />
                            <!-- Rows per damage type -->
                            <ItemsControl ItemsSource="{Binding DamageRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DamageTypeRow">
                                        <Grid ColumnDefinitions="90,*,*" Margin="0,1">
                                            <TextBlock Grid.Column="0" Text="{Binding Type}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" />
                                            <TextBlock Grid.Column="1" Text="{Binding Min}"
                                                       Foreground="{DynamicResource AttrDexBrush}" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       FontFamily="Cascadia Code,Consolas,monospace" />
                                            <TextBlock Grid.Column="2" Text="{Binding Max}"
                                                       Foreground="{DynamicResource AttrDexBrush}" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       FontFamily="Cascadia Code,Consolas,monospace" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Attack/Cast Rate + Crits side by side -->
                    <Grid ColumnDefinitions="*,6,*">

                        <!-- Attack / Cast Rate -->
                        <Border Grid.Column="0" Classes="infobox">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{loc:Tr Calc_AttackRate}" Classes="boxheader" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Calc_Speed}" Classes="statlabel" />
                                    <TextBlock Grid.Column="1" Text="{Binding SpeedText}" Classes="statvalue" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Calc_CastTime}" Classes="statlabel" />
                                    <TextBlock Grid.Column="1" Text="{Binding CastTimeText}" Classes="statvalue" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Calc_HitChance}" Classes="statlabel" />
                                    <TextBlock Grid.Column="1" Text="{Binding HitChanceText}" Classes="statvalue" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Crits -->
                        <Border Grid.Column="2" Classes="infobox">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{loc:Tr Calc_Crits}" Classes="boxheader" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Calc_CritChance}" Classes="statlabel" />
                                    <TextBlock Grid.Column="1" Text="{Binding CritChanceText}" Classes="statvalue" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Calc_CritMult}" Classes="statlabel" />
                                    <TextBlock Grid.Column="1" Text="{Binding CritMultText}" Classes="statvalue" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Calc_CritEffect}" Classes="statlabel" />
                                    <TextBlock Grid.Column="1" Text="{Binding CritEffectText}" Classes="statvalue" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Breakdown panel (when stat is clicked) -->
                    <StackPanel Spacing="0"
                                IsVisible="{Binding SelectedStat, Converter={x:Static ObjectConverters.IsNotNull}}">

                        <!-- Title -->
                        <Border Background="{DynamicResource BgRaisedBrush}" Padding="10,6" Margin="0,4,0,0">
                            <TextBlock Text="{Binding BreakdownTitle}"
                                       FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>

                        <StackPanel Spacing="10" Margin="0,6,0,0">

                            <!-- Calc breakdown lines -->
                            <Border Classes="infobox">
                                <StackPanel Spacing="0">
                                    <TextBlock Text="{loc:Tr Calc_Calculation}" Foreground="{DynamicResource AttrIntBrush}"
                                               FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding BreakdownLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Cascadia Code,Consolas,monospace"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Padding="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Modifier source table -->
                            <Border Classes="infobox"
                                    IsVisible="{Binding HasModifierRows}">
                                <StackPanel Spacing="0">
                                    <TextBlock Text="{loc:Tr Calc_ModSources}" Foreground="{DynamicResource AttrIntBrush}"
                                               FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                    <Grid ColumnDefinitions="60,60,80,*" Margin="0,0,0,2">
                                        <TextBlock Grid.Column="0" Text="{loc:Tr Calc_ColValue}"  Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{loc:Tr Calc_ColType}"   Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Grid.Column="2" Text="{loc:Tr Calc_ColSource}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Grid.Column="3" Text="{loc:Tr Calc_ColName}"   Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource BorderStrongBrush}" Margin="0,0,0,2" />
                                    <ItemsControl ItemsSource="{Binding ModifierRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="engine:ModifierEntry">
                                                <Grid ColumnDefinitions="60,60,80,*" Margin="0,1">
                                                    <TextBlock Grid.Column="0" Text="{Binding Value}"
                                                               Foreground="{DynamicResource AttrDexBrush}" FontSize="11"
                                                               FontFamily="Cascadia Code,Consolas,monospace" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ModType}"
                                                               Foreground="{DynamicResource StatArmourBrush}" FontSize="10" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Source}"
                                                               Foreground="{DynamicResource AttrIntBrush}" FontSize="10" />
                                                    <TextBlock Grid.Column="3" Text="{Binding SourceName}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </StackPanel>

                    <!-- Hint when nothing is selected -->
                    <TextBlock Text="{loc:Tr Calc_ClickStat}"
                               IsVisible="{Binding SelectedStat, Converter={x:Static ObjectConverters.IsNull}}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0" />

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>

</UserControl>
